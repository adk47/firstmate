#!/usr/bin/env python3
"""sa-store - the SA event store CLI (SA-01).

The Engine's only write path is ``sa-store append``. Every other verb reads the
log and folds it. See ``sa/README.md`` and design.md §6.

    sa-store append --type T --actor A [--ticket X] [--at ISO] [--payload JSON]
    sa-store state [--table NAME]
    sa-store tables
    sa-store query --table NAME [--where k=v]...
    sa-store selftest
    sa-store log

Python 3 stdlib only.
"""

from __future__ import annotations

import argparse
import difflib
import json
import os
import shutil
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from sa_paths import canonical, events_path, sa_home, sha256_of  # noqa: E402
from sa_store import (  # noqa: E402
    ACTORS,
    EVENT_TYPES,
    TABLE_ORDER,
    StoreError,
    append_event,
    fold,
    query,
    read_events,
    snapshot,
    table,
)

#: Deterministic fixture covering every event type in design.md §5.
FIXTURE = (
    ("ticket.created", "router", "T-0001", "2026-11-05T02:00:00Z",
     {"title": "Add store", "body": "build it", "requester": "aaron",
      "acceptance": {"command": "python3 -m unittest discover -s sa/tests"}}),
    ("ticket.classified", "router", "T-0001", "2026-11-05T02:00:01Z",
     {"class": "code"}),
    ("ticket.assigned", "router", "T-0001", "2026-11-05T02:00:02Z",
     {"owner": "worker-a", "reason": "scope match"}),
    ("assignment.created", "router", "T-0001", "2026-11-05T02:00:03Z",
     {"owner": "worker-a", "reason": "scope match"}),
    ("mandate.issued", "engine", "T-0001", "2026-11-05T02:00:04Z",
     {"requester": "aaron", "scope_paths": ["sa/"],
      "rules_in_force": ["no-delete"], "expires_at": "2026-11-06T02:00:00Z"}),
    ("ticket.dispatched", "engine", "T-0001", "2026-11-05T02:00:05Z",
     {"worktree": "/tmp/sa-wt", "brief": "/tmp/sa-brief.md",
      "worker": "worker-a", "mandate": "T-0001"}),
    ("thread.opened", "router", "T-0001", "2026-11-05T02:00:06Z",
     {"thread": "th-0001"}),
    ("thread.message", "router", "T-0001", "2026-11-05T02:00:07Z",
     {"thread": "th-0001", "text": "started", "actor": "router"}),
    ("sub.spawned", "engine", "T-0001", "2026-11-05T02:00:08Z",
     {"sub": "sub-0001", "parent": "worker-a", "role": "scout"}),
    ("outbox.enqueued", "code", "T-0001", "2026-11-05T02:00:09Z",
     {"event_id": "ev-0000000000000001", "owner": "worker-a"}),
    ("outbox.delivered", "code", "T-0001", "2026-11-05T02:00:10Z",
     {"event_id": "ev-0000000000000001", "owner": "worker-a",
      "receipt": {"path": "/tmp/inbox/worker-a/ev-0000000000000001.json",
                  "sha256": "0" * 64, "at": "2026-11-05T02:00:10Z"}}),
    ("outbox.failed", "code", "T-0001", "2026-11-05T02:00:11Z",
     {"event_id": "ev-0000000000000002", "owner": "worker-a",
      "attempt": 1, "error": "EACCES"}),
    ("ruling.recorded", "router", "T-0001", "2026-11-05T02:00:12Z",
     {"ruling": "allow", "rationale": "inside mandate scope"}),
    ("usage.recorded", "worker", "T-0001", "2026-11-05T02:00:13Z",
     {"tier": "t1", "tokens": 1200, "calls": 3}),
    ("claim.recorded", "worker", "T-0001", "2026-11-05T02:00:14Z",
     {"claim": "store selftest passes",
      "evidence_command": "sa/bin/sa-store selftest"}),
    ("ticket.refused", "engine", "T-0002", "2026-11-05T02:00:15Z",
     {"missing_question": "What command proves this ticket is done?"}),
    ("mandate.revoked", "engine", "T-0001", "2026-11-05T02:00:16Z",
     {"reason": "ticket landed"}),
)


def _print(text: str) -> None:
    sys.stdout.write(text + "\n")


def cmd_append(args) -> int:
    payload = {}
    if args.payload is not None:
        try:
            payload = json.loads(args.payload)
        except json.JSONDecodeError as exc:
            raise StoreError(f"--payload is not valid JSON: {exc}") from exc
        if not isinstance(payload, dict):
            raise StoreError("--payload must be a JSON object")
    event = append_event(
        type=args.type,
        actor=args.actor,
        ticket=args.ticket,
        at=args.at,
        payload=payload,
    )
    _print(event["id"])
    return 0


def cmd_state(args) -> int:
    state = snapshot()
    if args.table:
        _print(canonical(table(state, args.table)))
    else:
        _print(canonical(state))
    return 0


def cmd_tables(_args) -> int:
    for name in TABLE_ORDER:
        _print(name)
    return 0


def cmd_query(args) -> int:
    state = snapshot()
    _print(canonical(query(state, args.table, args.where)))
    return 0


def cmd_log(_args) -> int:
    path = events_path()
    if not path.exists():
        return 0
    sys.stdout.write(path.read_text(encoding="utf-8"))
    return 0


def _diff(a: str, b: str) -> str:
    return "\n".join(
        difflib.unified_diff(
            json.dumps(json.loads(a), indent=2, sort_keys=True).splitlines(),
            json.dumps(json.loads(b), indent=2, sort_keys=True).splitlines(),
            fromfile="state A",
            tofile="state B",
            lineterm="",
        )
    )


def cmd_selftest(_args) -> int:
    """Replay a deterministic fixture log twice and prove byte-identical state."""
    tmp = Path(tempfile.mkdtemp(prefix="sa-selftest-"))
    try:
        home = tmp / "home"
        home.mkdir()
        for type_, actor, ticket, at, payload in FIXTURE:
            append_event(
                type=type_, actor=actor, ticket=ticket, at=at,
                payload=payload, home=home,
            )

        log = events_path(home)
        lines = [line for line in log.read_text(encoding="utf-8").splitlines() if line]
        seen_types = {json.loads(line)["type"] for line in lines}
        missing_types = [t for t in EVENT_TYPES if t not in seen_types]

        state_a = fold(read_events(home))
        state_b = fold(read_events(home))
        json_a = canonical(state_a)
        json_b = canonical(state_b)
        hash_a = sha256_of(state_a)
        hash_b = sha256_of(state_b)

        missing_tables = [t for t in TABLE_ORDER if t not in state_a]

        _print(f"SA_HOME: {home}")
        _print(f"events: {len(lines)}")
        _print(f"event types covered: {len(seen_types)}/{len(EVENT_TYPES)}")
        _print(f"tables present: {len(TABLE_ORDER) - len(missing_tables)}/{len(TABLE_ORDER)}")
        _print(f"state A sha256: {hash_a}")
        _print(f"state B sha256: {hash_b}")

        failures = []
        if missing_types:
            failures.append(f"fixture missing event types: {', '.join(missing_types)}")
        if missing_tables:
            failures.append(f"missing tables: {', '.join(missing_tables)}")
        if hash_a != hash_b:
            failures.append("state A and state B differ:\n" + _diff(json_a, json_b))
        if failures:
            for failure in failures:
                _print(f"FAIL: {failure}")
            return 1
        _print("PASS")
        return 0
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sa-store",
        description="SA event store: append-only log, pure fold, ten tables.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_append = sub.add_parser("append", help="append one event (the only write path)")
    p_append.add_argument("--type", required=True, help="event type, e.g. ticket.created")
    p_append.add_argument("--actor", required=True, choices=ACTORS)
    p_append.add_argument("--ticket", default=None, help="ticket id or omit for null")
    p_append.add_argument("--at", default=None, help="ISO-8601 UTC; defaults to now")
    p_append.add_argument("--payload", default=None, help="JSON object")
    p_append.set_defaults(func=cmd_append)

    p_state = sub.add_parser("state", help="print the folded snapshot as canonical JSON")
    p_state.add_argument("--table", default=None, help="print one table only")
    p_state.set_defaults(func=cmd_state)

    p_tables = sub.add_parser("tables", help="print the ten table names")
    p_tables.set_defaults(func=cmd_tables)

    p_query = sub.add_parser("query", help="print matching rows as a canonical JSON array")
    p_query.add_argument("--table", required=True)
    p_query.add_argument("--where", action="append", default=[], metavar="K=V")
    p_query.set_defaults(func=cmd_query)

    p_selftest = sub.add_parser("selftest", help="replay a fixture log twice, prove identical")
    p_selftest.set_defaults(func=cmd_selftest)

    p_log = sub.add_parser("log", help="print the raw event log")
    p_log.set_defaults(func=cmd_log)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except StoreError as exc:
        sys.stderr.write(f"sa-store: {exc}\n")
        return 1
    except ValueError as exc:
        sys.stderr.write(f"sa-store: {exc}\n")
        return 1


if __name__ == "__main__":
    sys.exit(main())
