            # A substitution is ONE word however much whitespace it contains.
            # Breaking at the space inside `x=$(basename "$d")` left the walker
            # standing inside the substitution, where it read `"$d")` as a
            # command word and refused 30 correct lines of deploy.sh.
            if (q != sq && c == "$" && substr(rec, i + 1, 1) == "(") {
              wq = 1; dep = 1; i += 2
              while (i <= eo && dep > 0) {
                cc = substr(rec, i, 1)
                if (cc == "\\") { i += 2; continue }
                if (qq == sq) { if (cc == sq) qq = ""; i++; continue }
                if (qq == dq) { if (cc == dq) qq = ""; i++; continue }
                if (cc == sq || cc == dq) { qq = cc; i++; continue }
                if (cc == "(") dep++
                else if (cc == ")") dep--
                i++
              }
              w = w "$()"; continue
            }
            if (q != sq && c == "`") {
              wq = 1; i++
              while (i <= eo && substr(rec, i, 1) != "`") { if (substr(rec, i, 1) == "\\") i++; i++ }
              i++; w = w "``"; continue
            }
            if (q == sq) { if (c == sq) q = ""; else w = w c; i++; continue }
            if (q == dq) {
              if (c == dq) q = ""
              else { if (c == "$" || c == "`") wq = 1; w = w c }
              i++; continue
            }
            if (c == sq) { q = sq; i++; continue }
            if (c == dq) { q = dq; i++; continue }
            if (c == "$" || c == "`") wq = 1
            w = w c; i++
          }
          # want=1 asks about ARGV. Past the command word every remaining
          # word counts, and reusing this walker is the point: a separate
          # whitespace-splitting version mis-read a command word that
          # CONTAINS a space (a backtick substitution) as half argv.
          if (want && cwdone) { if (wq) return 1; continue }
          if (w ~ /^[A-Za-z_][A-Za-z0-9_]*=/) continue
          if (w ~ redir) { if (w ~ /^([0-9]*|&)(<|>)+$/) skipnext = 1; continue }
          if (skipnext) { skipnext = 0; continue }
          if (w ~ "^(" kw ")$") continue
          if (w ~ "(^|/)(" wrap ")$") { sawwrap = 1; continue }
          if (w ~ "(^|/)(" otool ")$") { scanon = 1; continue }
          if (scanon && !sawwrap) { if (w ~ execslot) sawwrap = 1; continue }
          if (w ~ execslot) { sawwrap = 1; continue }
          # Past a wrapper an option, an operand and the wrapped command are
          # indistinguishable without a per-wrapper option table, exactly as
          # in cmdword(). That cuts both ways, so the answer is to FAIL CLOSED
          # rather than to guess: any expansion after a wrapper might be the
          # wrapped command, and `sudo r${mid}c -az --delete ./ live/` runs an
          # unguarded rsync (QA finding 37). Returning at the first word past
          # the wrapper is not enough either -- `sudo -u root r${mid}c` hides
          # the expansion behind an option -- so scan the whole segment and
          # refuse on the first expansion found. deploy.sh pays for this with
          # ONE reviewed marker, on a find whose operand is a path.
          if (sawwrap) { if (wq) return 1; continue }
          if (want) { cwdone = 1; continue }
          return wq
        }
        return 0
      }
      # Judge one command: is it rsync, and if so does its ARGV carry the guard.
      # Text after a redirection operator is not argv -- the array supplied as a
      # here-string is stdin and excludes nothing.
      function judge(so, eo, truepos,   bt, rt, cw, k, j, i2, ch, segraw) {
        if (eo < so) return
        bt = substr(b, so, eo - so + 1)
        cw_off = 0
        cw = cmdword(bt)
        if (cw !~ /(^|\/)rsync$/) {
          # An EXPANSION in command position names its command only at run
          # time, so this gate cannot judge it and refuses instead of skipping
          # the segment silently (QA finding 29a). blank() leaves such a word
          # as spaces, which is why cw is empty here.
          # BACKTICKS are a command substitution too. Matching only $-led words
          # let `printf rsync` -az --delete ./ live/ fall through as "not
          # rsync" and the segment was skipped in silence (QA finding 35).
          # blank() already records backtick bodies -- it is only this
          # command-position test that was $-only.
          if (truepos) {
            # The marker is scoped to the RECORD, so it must not be able to
            # authorise a segment that deletes. Judged on THIS segment, not
            # the line, which is what binds the review to its own command.
            segraw = substr(rec, so, eo - so + 1)
            # Three levels, strongest first: a literal destructive flag is
            # never reviewable; argv that expands needs the explicit
            # reviewed-argv assertion as well; anything else needs the
            # ordinary marker.
            if (cw_expands(so, eo, 0) \
                && (segraw ~ destructive || segraw ~ dynopt \
                    || reccomment !~ /hydra-hook:[[:space:]]*reviewed-indirection/ \
                    || (cw_expands(so, eo, 1) && reccomment !~ /reviewed-argv/))) indirection++
          }
          return
        }
        calls++
        if (cw_off > 1) { so = so + cw_off - 1; bt = substr(b, so, eo - so + 1) }
        # The guard only counts where rsync would read it as an OPTION.
        #   - `--` ends option parsing, so anything after it expands as
        #     operands (source paths) and excludes nothing;
        #   - a literal inside a command substitution is an argument to the
        #     INNER command, not an option to this rsync.
        # Treating the bare literal anywhere in the span as proof of guarding
        # reported both as green (QA finding 17).
        for (k = so; k <= eo - 1; k++) {
          if (substr(b, k, 2) == "--" && substr(b, k + 2, 1) ~ /[[:space:]]|^$/ \
              && (k == so || substr(b, k - 1, 1) ~ /[[:space:]]/)) { eo = k - 1; break }
        }
        if (eo < so) { unguarded++; return }
        rt = substr(rec, so, eo - so + 1)
        # Redirections may sit BETWEEN argv elements. Truncating argv at the
        # first one hid a guard that followed it and REJECTED a correctly
        # guarded call (QA finding 27c) -- the commit-blocking class. Blank the
        # operator and its target instead, so the rest of argv still counts,
        # while a here-string still cannot supply the guard.
        for (k = so; k <= eo; k++) {
          if (substr(b, k, 1) !~ /[<>]/) continue
          j = k
          while (j <= eo && substr(b, j, 1) ~ /[<>]/) j++
          while (j <= eo && substr(b, j, 1) ~ /[[:space:]]/) j++
          while (j <= eo && substr(b, j, 1) !~ /[[:space:]]/) j++
          for (i2 = k; i2 < j; i2++) rt = substr(rt, 1, i2 - so) " " substr(rt, i2 - so + 2)
          k = j - 1
        }
        # Only bodies NESTED INSIDE argv are masked. A body that CONTAINS this
        # call is the substitution the call itself lives in -- deploy.sh writes
        # six of its eight calls as dry_out=$(rsync ... "${RSYNC_EXCLUDES[@]}")
        # -- and masking that would erase the call is own guard.
        for (k = 1; k <= nbody; k++) {
          if (bs[k] <= so || be[k] > eo) continue
          for (j = (bs[k] > so ? bs[k] : so); j <= (be[k] < eo ? be[k] : eo); j++)
            rt = substr(rt, 1, j - so) " " substr(rt, j - so + 2)
        }
        if (index(rt, guard) == 0) unguarded++
      }
      # Split a span at top-level control operators and judge each command.
      # Split a span at every COMMAND POSITION and judge each command. Control
      # operators end a command; so does shell grouping punctuation -- a
      # subshell or brace group starts a fresh command, and treating ( and { as
      # ordinary tokens made cmdword() return the bracket and miss the call
      # inside it (QA finding 8).
      # truepos marks a segment that begins at a REAL command boundary (record
      # start, or ; & |). Segments produced by grouping punctuation are often
      # argument fragments, and treating those as commands made the dynamic
      # command-word check over-fire 4x on deploy.sh.
      function scan(so, eo,   k, seg, truepos) {
        seg = so; truepos = 1
        for (k = so; k <= eo; k++) {
          # An ampersand inside an fd-dup redirection (2>&1, <&0, &>log) is
          # part of the redirection, not a command separator. Splitting there
          # put the guard in a different segment and REJECTED a correctly
          # guarded call (QA finding 31b).
          if (substr(b, k, 1) == "&" && (substr(b, k - 1, 1) ~ /[<>]/ || substr(b, k + 1, 1) == ">")) continue
          if (substr(b, k, 1) ~ /[;&|(){}]/) {
            judge(seg, k - 1, truepos)
            truepos = (substr(b, k, 1) ~ /[;&|]/)
            seg = k + 1
          }
        }
        judge(seg, eo, truepos)
      }
      {
        while (/\\$/ && (getline nxt) > 0) { sub(/\\$/, ""); $0 = $0 nxt }
        rec = $0
        reccomment = ""     # trailing comment text, filled in by the strip below
        b = blank(rec)

        for (i = 1; i <= length(b); i++) {
          c = substr(b, i, 1)
          if (c == "#" && (i == 1 || substr(b, i - 1, 1) ~ /[[:space:];&|()]/)) {
            # Keep the comment text: the reviewed-indirection marker is only
            # valid HERE, not anywhere on the record. Testing the raw record
            # let printed data authorise itself (QA finding 30) -- the same
            # bypass fixed in the preprocessor one round earlier.
            reccomment = substr(rec, i)
            b = substr(b, 1, i - 1); rec = substr(rec, 1, i - 1); break
          }
        }

        # Each command-substitution body is its own command list, so it is
        # scanned separately; masking the bodies out of the parent keeps a
        # substitution from being read as part of the enclosing command.
        top = b
        for (i = 1; i <= nbody; i++) {
          if (bs[i] > length(b)) continue
          e = be[i]; if (e > length(b)) e = length(b)
          for (j = bs[i]; j <= e; j++) top = substr(top, 1, j - 1) " " substr(top, j + 1)
        }
        save = b; b = top; scan(1, length(b)); b = save
        for (i = 1; i <= nbody; i++) {
          if (bs[i] > length(b)) continue
          e = be[i]; if (e > length(b)) e = length(b)
          scan(bs[i], e)
        }
      }
      END { printf "%d %d %d\n", calls + 0, unguarded + 0, indirection + 0 }
    ' <<<"$deploy_code"
  )
  if (( rsync_calls == 0 )); then
    fail "deploy.sh contains zero rsync calls — something is very wrong"
  elif (( ${rsync_indirection:-0} > 0 )); then
    fail "deploy.sh uses shell indirection this gate cannot inspect (${rsync_indirection} site(s): a non-literal \`eval\`, or an interpreter script whose text is only known at run time). Write the command plainly, or mark a reviewed site with '# hydra-hook: reviewed-indirection'."
  elif (( rsync_unguarded > 0 )); then
    fail "deploy.sh has $rsync_unguarded of $rsync_calls rsync call(s) that do not pass \"\${RSYNC_EXCLUDES[@]}\" — every rsync must"
  fi

  if (( ${#missing_excludes[@]} > 0 )) || (( rsync_calls == 0 )) || (( rsync_unguarded > 0 )) || (( ${rsync_indirection:-0} > 0 )); then
    cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    scripts/deploy.sh runs `rsync --delete` from this repo to
    /opt/hydra/ on node-8. Anything on the server that isn't in the
    repo gets WIPED unless --exclude protects it. The required list
    above covers paths we've confirmed contain real production state:
      • workspaces/*/memory/        → dispute trackers, scan results
      • workspaces/*/api-logs/      → audit trail of external API calls
      • workspaces/*/MEMORY.md      → agent persistent long-term memory
                                      (written at runtime, seeded in repo)
      • workspaces/*/backups/       → agent-created backup snapshots
      • workspaces/*/reports/       → generated reports (CSVs/PDFs/JSON
                                      from agent runs — often PII)
      • workspaces/*/.openclaw/     → runtime workspace state
      • workspaces/*/IDENTITY.md    → agent identity (server-owned)
      • workspaces/*/HEARTBEAT.md   → liveness signal
      • workspaces/*/*.csv          → ad-hoc CSV outputs agents write to
                                      the workspace root (currently CMO's
                                      b2b target research — may contain
                                      PII). Temporary until agents move
                                      their ephemeral outputs to reports/.
      • secrets/                    → credentials directory (deploy keys,
                                      API tokens) — wiping this on deploy
                                      would break EVERYTHING.
      • audit/                      → per-workspace memory snapshots, conv logs
      • config/                     → dead CD shadow mirror (~16MB)
                                      from the pre-2026-04-08
                                      architecture. GitHub Actions no
                                      longer writes here. The exclude
                                      protects it until manual cleanup
                                      (rm -rf /opt/hydra/config/).
      • audit-local-backup/         → 8.6MB pre-existing backup of memory
                                      snapshots (node-8, 2026-04-07,
                                      from the audit/ migration)
      • plugins/*/node_modules/     → server-side npm install artifacts
      • plugins/*/package-lock.json
      • scripts/hydra-heal.sh       → Aaron's incident-response health
                                      check script written directly on
                                      node-8 during a 2026-04-07 outage.
                                      Contains a hardcoded Vault token
                                      so it can't be committed until
                                      the token is rotated.

    If deploy.sh stops excluding any of these, the next deploy
    silently destroys live data. There is no backup.

  HOW TO FIX (do this — do NOT --no-verify):
    1. Open scripts/deploy.sh
    2. Find the RSYNC_EXCLUDES=( ... ) array near the top of the file
       (it's hoisted there because Step 0 also reads it)
    3. Add the missing --exclude='...' line(s) listed above to the array
    4. Make sure every rsync invocation still uses "${RSYNC_EXCLUDES[@]}"
       (this hook checks that automatically — there are 8 rsync calls
       in deploy.sh today: dry-runs in Step 0 and Step 4a (each with
       local + remote variants = 4), real syncs in Step 4b (local +
       remote = 2), Step 4c skills sync (1), and install_plugin update
       path (1). The count is free to grow — the check asserts that no
       rsync call LACKS the array, not that any two totals are equal.)
    5. Re-run: bash .githooks/pre-commit

  IF YOU INTENTIONALLY REMOVED AN EXCLUDE:
    You must also remove it from required_excludes=( ... ) in this
    pre-commit script. But before you do that, prove the path is empty
    on the server (uses the same SSH defaults as deploy.sh — see the
    SSH config block at the top of scripts/deploy.sh):
      ssh -i "$SSH_KEY" "$NODE8_USER@$NODE8_IP" 'ls -la /opt/hydra/<path>'
    If it's not empty, you'll wipe data. Don't do it.

  WHEN BYPASSING IS OK:
    Never. This check exists because we already lost data this way.
  ──────────────────────────────────────────────────────────────────
BRIEFING
  else
    ok "required excludes present, all $rsync_calls rsync call(s) use shared array"
  fi
fi

# ---------------------------------------------------------------
# Check 3: no newly-staged files under runtime-data paths
# (prevents someone accidentally committing a dispute-tracker snapshot
# or api-log dump pulled from the server)
# ---------------------------------------------------------------
echo "  [3/7] staged files not under runtime-data paths"
staged=$(git diff --cached --name-only --diff-filter=A)
# Block paths that are 100% server-owned. We deliberately do NOT block
# IDENTITY.md / HEARTBEAT.md / .openclaw — those are mixed (some workspaces
# track them as seeds, others don't), so blocking would create false fails.
blocked_patterns='^(workspaces/[^/]+/(memory|api-logs|reports)|audit)/'
if [[ -n "$staged" ]]; then
  violations=$(echo "$staged" | grep -E "$blocked_patterns" || true)
  if [[ -n "$violations" ]]; then
    fail "runtime-data paths must not be committed:"
    while IFS= read -r v; do red "      $v"; done <<< "$violations"
    cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    The paths above hold live data that the server owns:
      • workspaces/*/memory/   accumulating state (dispute trackers, etc)
      • workspaces/*/api-logs/ rolling audit logs
      • audit/                 per-workspace memory snapshots, conv logs

    These are gitignored. If they end up staged, it usually means
    someone copied them down from node-8 (e.g. via rsync) and ran
    `git add -f` or `git add -A`. Committing a snapshot here:
      • forks the data — repo and server diverge
      • can leak sensitive customer data into git history
      • ages instantly (the snapshot is wrong by tomorrow)

  HOW TO FIX (do this — do NOT --no-verify):
    1. Unstage the offending files:
         git restore --staged <path>
    2. If you actually wanted to look at the data, leave it on disk
       (it stays gitignored) but don't commit it.
    3. If you genuinely need a snapshot in the repo for a one-off
       investigation, put it under docs/local/ instead — that path is
       gitignored and won't trigger this check.

  WHEN BYPASSING IS OK:
    Never via --no-verify. If the file genuinely belongs in the repo,
    update the blocked_patterns regex in this hook AND .gitignore in
    the same commit, and explain why in the commit message.
  ──────────────────────────────────────────────────────────────────
BRIEFING
  else
    ok "no staged files under runtime-data paths"
  fi
else
  ok "no newly-added files to check"
fi

# ---------------------------------------------------------------
# Check 4: shellcheck on staged *.sh files
# ---------------------------------------------------------------
# The 6 bash bugs in smoke-test.sh that caused 2026-04-07's deploy
# failures (broken `grep -c PATTERN || echo 0` patterns producing
# multi-line "0\n0") would all have been caught by shellcheck
# --severity=warning at commit time. This check makes that the
# default going forward.
#
# If shellcheck isn't installed locally, print a LOUD warning but
# don't block the commit — the CI gate (pr-validate.yml) catches
# issues at PR time regardless.
echo "  [4/7] shellcheck on staged *.sh files"
if ! command -v shellcheck >/dev/null 2>&1; then
  yellow ""
  yellow "══════════════════════════════════════════════════════════════════════"
  yellow "⚠  SHELLCHECK NOT INSTALLED — FLYING BLIND ON BASH BUGS"
  yellow "══════════════════════════════════════════════════════════════════════"
  yellow "You are committing bash code without shellcheck validation. The CI"
  yellow "gate will still catch issues, but you won't see them until PR review."
  yellow ""
  yellow "Install: brew install shellcheck   (macOS)"
  yellow "         apt install shellcheck    (debian/ubuntu)"
  yellow ""
  yellow "Recent bash bugs that shellcheck would have caught at commit time:"
  yellow "  - smoke-test.sh 6x grep -c PATTERN || echo 0 (2026-04-07)"
  yellow "  - Caused 18 smoke-test failures per deploy / silent rollback loop"
  yellow "══════════════════════════════════════════════════════════════════════"
  yellow ""
  ok "skipped (shellcheck not installed)"
else
  # Stage detection: any *.sh AND .githooks/pre-commit (which has no
  # extension but is the very tool we're hardening — must be linted).
  staged_sh=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(\.sh$|\.bash$|^\.githooks/pre-commit$)' || true)
  if [[ -z "$staged_sh" ]]; then
    ok "no staged *.sh files"
  else
    sc_failed=0
    while IFS= read -r f; do
      if ! shellcheck --severity=warning "$f"; then
        sc_failed=1
      fi
    done <<< "$staged_sh"
    if (( sc_failed != 0 )); then
      fail "shellcheck failed on one or more staged *.sh files"
      cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    On 2026-04-07, 6 instances of the grep -c PATTERN || echo 0
    antipattern shipped to production in scripts/smoke-test.sh. Every
    deploy from that commit on FAILED silently at the smoke test with
    18 cascading check failures because || echo 0 produced multi-line
    "0\n0" from grep's zero-match output.

    shellcheck --severity=warning catches this exact antipattern via
    SC2126. Running shellcheck at commit time would have prevented the
    entire outage class.

  HOW TO FIX (do this — do NOT --no-verify):
    1. Read the shellcheck output above. Each finding has a link
       to https://www.shellcheck.net/wiki/SCxxxx with explanation.
    2. Fix the code or silence with a targeted
           # shellcheck disable=SCxxxx  # reason
       comment if the warning is actually a false positive.
    3. Re-stage and retry the commit.

  WHEN BYPASSING IS OK:
    Almost never. If you really need to bypass, use --no-verify and
    document the reason in the commit message. The CI gate will still
    catch it and block the PR.
  ──────────────────────────────────────────────────────────────────
BRIEFING
    else
      ok "shellcheck passed on $(echo "$staged_sh" | wc -l | tr -d ' ') staged *.sh file(s)"
    fi
  fi
fi

