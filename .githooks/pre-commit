#!/usr/bin/env bash
# HYDRA pre-commit hook
# =====================
# Static invariants that must hold before every commit. Runs offline, no network.
# Install: scripts/setup-hooks.sh (or: git config core.hooksPath .githooks)
#
# READ THIS BEFORE BYPASSING WITH --no-verify:
# Each failing check below prints a multi-line briefing explaining what
# the check protects, what will break in production if you skip it, and
# the exact steps to fix the underlying problem instead of bypassing.
# --no-verify is a footgun. Use it only after reading the briefing and
# confirming the fix is genuinely impossible right now.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

red()   { printf '\033[0;31m%s\033[0m\n' "$*"; }
green() { printf '\033[0;32m%s\033[0m\n' "$*"; }
yellow(){ printf '\033[0;33m%s\033[0m\n' "$*"; }

fail_count=0
fail() { red "  ✗ $*"; fail_count=$((fail_count+1)); }
ok()   { green "  ✓ $*"; }

echo "→ hydra pre-commit checks"

# nullglob: empty/missing skills-all/ should produce zero loop iterations,
# not a literal `skills-all/*/` token that the [[ -d ]] guard then skips.
shopt -s nullglob

# ---------------------------------------------------------------
# Check 1: every skills-all/<skill>/ has a SKILL.md
# ---------------------------------------------------------------
echo "  [1/7] skills-all structure"
if [[ ! -d skills-all ]]; then
  fail "skills-all/ directory missing — refusing to commit (this would silently 'pass' an empty skill set)"
fi
missing_skill_md=()
skill_count=0
for d in skills-all/*/; do
  [[ -d "$d" ]] || continue
  skill_count=$((skill_count + 1))
  if [[ ! -f "${d}SKILL.md" ]]; then
    missing_skill_md+=("$d")
  fi
done
if (( skill_count == 0 )); then
  fail "skills-all/ contains zero skills — refusing to commit (something deleted all of them?)"
elif (( ${#missing_skill_md[@]} > 0 )); then
  fail "skills missing SKILL.md:"
  for s in "${missing_skill_md[@]}"; do red "      $s"; done
  cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    Every directory under skills-all/ MUST have a SKILL.md or the
    openclaw runtime can't load the skill. A skill dir without SKILL.md
    is dead weight at best, a load-time crash at worst.

  HOW TO FIX (do this — do NOT --no-verify):
    1. For each path above, either:
       (a) Create the missing SKILL.md (frontmatter + body), OR
       (b) Delete the empty/broken directory entirely:
             git rm -r skills-all/<name>/
    2. Re-stage and retry the commit.

  WHEN BYPASSING IS OK:
    Almost never. The commit will land but the skill is broken until
    fixed. If you bypass, open an issue immediately.
  ──────────────────────────────────────────────────────────────────
BRIEFING
else
  ok "all $skill_count skills have SKILL.md"
fi

# ---------------------------------------------------------------
# Check 2: deploy.sh carries the required runtime-data excludes
# These paths hold server-only state (dispute trackers, api logs)
# that --delete would wipe out. The excludes live in a shared
# RSYNC_EXCLUDES array — we assert:
#   (a) each required exclude is declared (in code, not in a comment)
#   (b) at least one rsync call exists, and EVERY rsync call references
#       the shared array (so a future "I'll just call rsync directly"
#       can't accidentally bypass the excludes)
# ---------------------------------------------------------------
echo "  [2/7] deploy.sh safety excludes"
DEPLOY_SH="scripts/deploy.sh"
# This list is the enforced SUBSET of deploy.sh's RSYNC_EXCLUDES. The
# check is one-directional: it asserts every entry below is present in
# RSYNC_EXCLUDES, so removing a load-bearing protection from deploy.sh
# fails the commit. It deliberately omits repo-hygiene entries like
# .git, .deployed-sha, and hydra docs/ which are in RSYNC_EXCLUDES for
# other reasons (not data-loss protection). If you add a new exclude
# to deploy.sh that protects live server state, add it here too.
required_excludes=(
  "workspaces/*/memory/"
  "workspaces/*/api-logs/"
  "workspaces/*/MEMORY.md"
  "workspaces/*/backups/"
  "workspaces/*/reports/"
  "workspaces/*/.openclaw/"
  "workspaces/*/IDENTITY.md"
  "workspaces/*/HEARTBEAT.md"
  "workspaces/*/TOOLS.md"
  "workspaces/*/TOOLS.md.bak-*"
  "workspaces/*/*.md.bak-*"
  "workspaces/*/*.jpeg"
  "workspaces/*/*.jpg"
  "workspaces/*/*.webp"
  "workspaces/*/*.gif"
  "workspaces/*/*.pdf"
  "workspaces/*/intercom/"
  "workspaces/*/skills/gog/"
  "workspaces/*/skills/_archive/"
  "workspaces/*/skills/*/references/*-knowledge-base.md"
  "workspaces/*/write-activity.log"
  "workspaces/*/*.csv"
  "workspaces/*/.*pr-review-*.json"
  "secrets/"
  "audit/"
  "audit-local-backup/"
  "config/"
  "plugins/*/node_modules/"
  "plugins/*/package-lock.json"
  "scripts/hydra-heal.sh"
  "workspaces/cmo/parent-companies.md"
  ".admin-token-cache"
  ".ads-token-cache"
  "workspaces/*/.env"
  "workspaces/*/pending-tickets/"
  "workspaces/*/*.png"
  "workspaces/*/media/"
  "workspaces/*/generated/"
  "workspaces/*/presentations/"
  "workspaces/*/exports/"
  "workspaces/*/research/"
  "workspaces/*/wiki/"
  "workspaces/*/*.txt"
  "workspaces/*/skills/*/references/daily-batches/"
  "workspaces/*/tmp/"
  "workspaces/*/state/"
  "workspaces/*/scripts/"
  "__pycache__/"
  "*.pyc"
  "workspaces/*/.wrangler/"
)
if [[ ! -f "$DEPLOY_SH" ]]; then
  fail "$DEPLOY_SH not found"
else
  # Strip shell comments and heredoc bodies before structural greps.
  # Without this, a commented-out --exclude line ('# --exclude=...')
  # silently passes the check, AND words like "rsync" appearing in
  # briefing heredocs inflate the rsync call counter.
  #
  # Comment stripping: only WHOLE-LINE comments (^[[:space:]]*#.*$).
  # We do NOT strip inline trailing '# ...' on code lines — the awk
  # below uses sub() with a leading-anchor regex, not a mid-line one,
  # because correctly handling '#' inside quoted strings is hard. This
  # is fine because the required_excludes match against the full
  # --exclude='pat' literal — a real --exclude line can't sit after a
  # trailing '#' on the same line and still be syntactically valid.
  #
  # Heredoc stripping: drop lines between the opener (`<<[-]?[ws]*MARKER`)
  # and a line equal to MARKER. We keep the opener line so structural
  # counters still see whatever code preceded the heredoc on that line.
  # The opener regex permits whitespace between `<<` and the marker
  # (e.g. `bash << 'POSTSYNC'`) — without this, deploy.sh's POSTSYNC
  # heredoc body would flow through unstripped, re-creating the exact
  # silent-bypass class this preprocessor was meant to close.
  deploy_code=$(awk '
    BEGIN { in_heredoc = 0; marker = "" }
    {
      if (in_heredoc) {
        if ($0 == marker) { in_heredoc = 0; marker = "" }
        next
      }
      # detect <<MARKER, << MARKER, <<-MARKER, << '"'"'MARKER'"'"', <<"MARKER", etc.
      # The regex permits optional `-`, optional whitespace, optional
      # quote (single or double), then the marker word, then matching quote.
      if (match($0, /<<-?[[:space:]]*['"'"'"]?[A-Za-z_][A-Za-z0-9_]*['"'"'"]?/)) {
        m = substr($0, RSTART, RLENGTH)
        gsub(/^<<-?[[:space:]]*['"'"'"]?/, "", m)
        gsub(/['"'"'"]$/, "", m)
        in_heredoc = 1
        marker = m
        print  # keep the opening line so structural counters still see it
        next
      }
      # strip whole-line comments
      sub(/^[[:space:]]*#.*$/, "")
      print
    }
  ' "$DEPLOY_SH")

  missing_excludes=()
  for pat in "${required_excludes[@]}"; do
    if ! grep -qF -- "--exclude='$pat'" <<<"$deploy_code"; then
      missing_excludes+=("$pat")
    fi
  done
  if (( ${#missing_excludes[@]} > 0 )); then
    fail "deploy.sh missing required --exclude patterns:"
    for p in "${missing_excludes[@]}"; do red "      --exclude='$p'"; done
  fi

  # Count rsync invocations (in code, not comments) and array refs.
  # The regex must match both bare invocations (`rsync -a ...` at line
  # start) AND command-substitution patterns (`dry_out=$(rsync -an ...`).
  # We anchor on `rsync ` followed by a flag (`-`) so it never matches
  # the word "rsync" in prose, then rely on the comment-stripped
  # `deploy_code` to avoid matching documentation text.
  # We require: ≥1 rsync call AND every rsync call references the array.
  rsync_calls=$(grep -cE '(^|[[:space:]]|\()rsync -' <<<"$deploy_code") || rsync_calls=0
  rsync_with_excludes=$(grep -cF '"${RSYNC_EXCLUDES[@]}"' <<<"$deploy_code") || rsync_with_excludes=0
  if (( rsync_calls == 0 )); then
    fail "deploy.sh contains zero rsync calls — something is very wrong"
  elif (( rsync_with_excludes != rsync_calls )); then
    fail "deploy.sh has $rsync_calls rsync call(s) but $rsync_with_excludes reference \${RSYNC_EXCLUDES[@]} (must match exactly)"
  fi

  if (( ${#missing_excludes[@]} > 0 )) || (( rsync_calls == 0 )) || (( rsync_with_excludes != rsync_calls )); then
    cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    scripts/deploy.sh runs `rsync --delete` from this repo to
    /opt/hydra/ on node-8. Anything on the server that isn't in the
    repo gets WIPED unless --exclude protects it. The required list
    above covers paths we've confirmed contain real production state:
      • workspaces/*/memory/        → dispute trackers, scan results
      • workspaces/*/api-logs/      → audit trail of external API calls
      • workspaces/*/MEMORY.md      → agent persistent long-term memory
                                      (written at runtime, seeded in repo)
      • workspaces/*/backups/       → agent-created backup snapshots
      • workspaces/*/reports/       → generated reports (CSVs/PDFs/JSON
                                      from agent runs — often PII)
      • workspaces/*/.openclaw/     → runtime workspace state
      • workspaces/*/IDENTITY.md    → agent identity (server-owned)
      • workspaces/*/HEARTBEAT.md   → liveness signal
      • workspaces/*/*.csv          → ad-hoc CSV outputs agents write to
                                      the workspace root (currently CMO's
                                      b2b target research — may contain
                                      PII). Temporary until agents move
                                      their ephemeral outputs to reports/.
      • secrets/                    → credentials directory (deploy keys,
                                      API tokens) — wiping this on deploy
                                      would break EVERYTHING.
      • audit/                      → per-workspace memory snapshots, conv logs
      • config/                     → dead CD shadow mirror (~16MB)
                                      from the pre-2026-04-08
                                      architecture. GitHub Actions no
                                      longer writes here. The exclude
                                      protects it until manual cleanup
                                      (rm -rf /opt/hydra/config/).
      • audit-local-backup/         → 8.6MB pre-existing backup of memory
                                      snapshots (node-8, 2026-04-07,
                                      from the audit/ migration)
      • plugins/*/node_modules/     → server-side npm install artifacts
      • plugins/*/package-lock.json
      • scripts/hydra-heal.sh       → Aaron's incident-response health
                                      check script written directly on
                                      node-8 during a 2026-04-07 outage.
                                      Contains a hardcoded Vault token
                                      so it can't be committed until
                                      the token is rotated.

    If deploy.sh stops excluding any of these, the next deploy
    silently destroys live data. There is no backup.

  HOW TO FIX (do this — do NOT --no-verify):
    1. Open scripts/deploy.sh
    2. Find the RSYNC_EXCLUDES=( ... ) array near the top of the file
       (it's hoisted there because Step 0 also reads it)
    3. Add the missing --exclude='...' line(s) listed above to the array
    4. Make sure every rsync invocation still uses "${RSYNC_EXCLUDES[@]}"
       (this hook checks that automatically — there are 8 rsync calls
       in deploy.sh today: dry-runs in Step 0 and Step 4a (each with
       local + remote variants = 4), real syncs in Step 4b (local +
       remote = 2), Step 4c skills sync (1), and install_plugin update
       path (1). The exact count may grow as new steps are added.)
    5. Re-run: bash .githooks/pre-commit

  IF YOU INTENTIONALLY REMOVED AN EXCLUDE:
    You must also remove it from required_excludes=( ... ) in this
    pre-commit script. But before you do that, prove the path is empty
    on the server (uses the same SSH defaults as deploy.sh — see the
    SSH config block at the top of scripts/deploy.sh):
      ssh -i "$SSH_KEY" "$NODE8_USER@$NODE8_IP" 'ls -la /opt/hydra/<path>'
    If it's not empty, you'll wipe data. Don't do it.

  WHEN BYPASSING IS OK:
    Never. This check exists because we already lost data this way.
  ──────────────────────────────────────────────────────────────────
BRIEFING
  else
    ok "required excludes present, all $rsync_calls rsync call(s) use shared array"
  fi
fi

# ---------------------------------------------------------------
# Check 3: no newly-staged files under runtime-data paths
# (prevents someone accidentally committing a dispute-tracker snapshot
# or api-log dump pulled from the server)
# ---------------------------------------------------------------
echo "  [3/7] staged files not under runtime-data paths"
staged=$(git diff --cached --name-only --diff-filter=A)
# Block paths that are 100% server-owned. We deliberately do NOT block
# IDENTITY.md / HEARTBEAT.md / .openclaw — those are mixed (some workspaces
# track them as seeds, others don't), so blocking would create false fails.
blocked_patterns='^(workspaces/[^/]+/(memory|api-logs|reports)|audit)/'
if [[ -n "$staged" ]]; then
  violations=$(echo "$staged" | grep -E "$blocked_patterns" || true)
  if [[ -n "$violations" ]]; then
    fail "runtime-data paths must not be committed:"
    while IFS= read -r v; do red "      $v"; done <<< "$violations"
    cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    The paths above hold live data that the server owns:
      • workspaces/*/memory/   accumulating state (dispute trackers, etc)
      • workspaces/*/api-logs/ rolling audit logs
      • audit/                 per-workspace memory snapshots, conv logs

    These are gitignored. If they end up staged, it usually means
    someone copied them down from node-8 (e.g. via rsync) and ran
    `git add -f` or `git add -A`. Committing a snapshot here:
      • forks the data — repo and server diverge
      • can leak sensitive customer data into git history
      • ages instantly (the snapshot is wrong by tomorrow)

  HOW TO FIX (do this — do NOT --no-verify):
    1. Unstage the offending files:
         git restore --staged <path>
    2. If you actually wanted to look at the data, leave it on disk
       (it stays gitignored) but don't commit it.
    3. If you genuinely need a snapshot in the repo for a one-off
       investigation, put it under docs/local/ instead — that path is
       gitignored and won't trigger this check.

  WHEN BYPASSING IS OK:
    Never via --no-verify. If the file genuinely belongs in the repo,
    update the blocked_patterns regex in this hook AND .gitignore in
    the same commit, and explain why in the commit message.
  ──────────────────────────────────────────────────────────────────
BRIEFING
  else
    ok "no staged files under runtime-data paths"
  fi
else
  ok "no newly-added files to check"
fi

# ---------------------------------------------------------------
# Check 4: shellcheck on staged *.sh files
# ---------------------------------------------------------------
# The 6 bash bugs in smoke-test.sh that caused 2026-04-07's deploy
# failures (broken `grep -c PATTERN || echo 0` patterns producing
# multi-line "0\n0") would all have been caught by shellcheck
# --severity=warning at commit time. This check makes that the
# default going forward.
#
# If shellcheck isn't installed locally, print a LOUD warning but
# don't block the commit — the CI gate (pr-validate.yml) catches
# issues at PR time regardless.
echo "  [4/7] shellcheck on staged *.sh files"
if ! command -v shellcheck >/dev/null 2>&1; then
  yellow ""
  yellow "══════════════════════════════════════════════════════════════════════"
  yellow "⚠  SHELLCHECK NOT INSTALLED — FLYING BLIND ON BASH BUGS"
  yellow "══════════════════════════════════════════════════════════════════════"
  yellow "You are committing bash code without shellcheck validation. The CI"
  yellow "gate will still catch issues, but you won't see them until PR review."
  yellow ""
  yellow "Install: brew install shellcheck   (macOS)"
  yellow "         apt install shellcheck    (debian/ubuntu)"
  yellow ""
  yellow "Recent bash bugs that shellcheck would have caught at commit time:"
  yellow "  - smoke-test.sh 6x grep -c PATTERN || echo 0 (2026-04-07)"
  yellow "  - Caused 18 smoke-test failures per deploy / silent rollback loop"
  yellow "══════════════════════════════════════════════════════════════════════"
  yellow ""
  ok "skipped (shellcheck not installed)"
else
  # Stage detection: any *.sh AND .githooks/pre-commit (which has no
  # extension but is the very tool we're hardening — must be linted).
  staged_sh=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(\.sh$|^\.githooks/pre-commit$)' || true)
  if [[ -z "$staged_sh" ]]; then
    ok "no staged *.sh files"
  else
    sc_failed=0
    while IFS= read -r f; do
      if ! shellcheck --severity=warning "$f"; then
        sc_failed=1
      fi
    done <<< "$staged_sh"
    if (( sc_failed != 0 )); then
      fail "shellcheck failed on one or more staged *.sh files"
      cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    On 2026-04-07, 6 instances of the grep -c PATTERN || echo 0
    antipattern shipped to production in scripts/smoke-test.sh. Every
    deploy from that commit on FAILED silently at the smoke test with
    18 cascading check failures because || echo 0 produced multi-line
    "0\n0" from grep's zero-match output.

    shellcheck --severity=warning catches this exact antipattern via
    SC2126. Running shellcheck at commit time would have prevented the
    entire outage class.

  HOW TO FIX (do this — do NOT --no-verify):
    1. Read the shellcheck output above. Each finding has a link
       to https://www.shellcheck.net/wiki/SCxxxx with explanation.
    2. Fix the code or silence with a targeted
           # shellcheck disable=SCxxxx  # reason
       comment if the warning is actually a false positive.
    3. Re-stage and retry the commit.

  WHEN BYPASSING IS OK:
    Almost never. If you really need to bypass, use --no-verify and
    document the reason in the commit message. The CI gate will still
    catch it and block the PR.
  ──────────────────────────────────────────────────────────────────
BRIEFING
    else
      ok "shellcheck passed on $(echo "$staged_sh" | wc -l | tr -d ' ') staged *.sh file(s)"
    fi
  fi
fi

# ---------------------------------------------------------------
# Check 5: no hardcoded model names on SOUL.md **Model**: lines
# ---------------------------------------------------------------
# Workspace SOUL.md files used to hardcode the agent's model chain in
# the Identity block. On 2026-04-17 Ops claimed "Using GLM-5.1" in
# Slack one minute after the gateway had been restarted with
# sonnet-4-6 as primary — it was reading the stale SOUL.md line, not
# anything actually true. PR #112 + issue #117 sweep all 10 workspace
# SOUL.md files to a uniform directive that points at openclaw.json.
#
# This check blocks a regression: any staged SOUL.md whose **Model**:
# line mentions a model vendor/family gets rejected at commit time.
echo "  [5/7] SOUL.md hardcoded model names (issue #117)"
staged_soul=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^workspaces/[^/]+/SOUL\.md$' || true)
if [[ -z "$staged_soul" ]]; then
  ok "no staged workspace SOUL.md files"
else
  soul_failed=0
  soul_bad_re='\*\*Model\*\*:.*(glm|claude|opus|sonnet|haiku|deepseek|kimi|gpt-|fireworks)'
  while IFS= read -r f; do
    if grep -niE "$soul_bad_re" "$f" >/dev/null 2>&1; then
      soul_failed=1
      red "    ✗ $f:"
      grep -niE "$soul_bad_re" "$f" | sed 's/^/      /'
    fi
  done <<< "$staged_soul"
  if (( soul_failed != 0 )); then
    fail "hardcoded model name(s) on SOUL.md **Model**: line"
    cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    On 2026-04-17, Ops claimed in Slack it was running "GLM-5.1" one
    minute after its gateway had been restarted with sonnet-4-6 as
    primary. Root cause: workspaces/operations/SOUL.md:9 hardcoded
    the old model chain. Agents parrot whatever SOUL.md says.

    PR #112 fixed operations. Issue #117 swept the other nine. This
    check prevents the anti-pattern from coming back.

  HOW TO FIX:
    Replace the **Model**: line with the uniform directive:

      - **Model**: configured externally by the openclaw runtime; the
        authoritative chain lives in `openclaw.json` under
        `agents.list[<agent_id>].model`. Do NOT claim a specific
        model name in responses unless you have just verified it —
        this doc has drifted from reality before and caused
        confusion. If asked which model you are, either introspect
        via a tool that can check, or say you don't know without
        checking.

    Interpolate the right <agent_id> per file (design, devops, cto,
    qa, ceo, sentinel, cmo, support, finance, operations).

  WHEN BYPASSING IS OK:
    Essentially never. If you genuinely need a model name in prose
    (e.g., a historical note), put it somewhere that isn't the
    **Model**: line of SOUL.md.
  ──────────────────────────────────────────────────────────────────
BRIEFING
  else
    ok "no hardcoded model names on staged SOUL.md $(echo "$staged_soul" | wc -l | tr -d ' ') file(s)"
  fi
fi

# ---------------------------------------------------------------
# Check 6: SanitizingIntercomClient bypass guard
# createIntercomClient() is the only sanctioned way to build an
# outbound Intercom client. Direct `new RealIntercomClient(...)`
# anywhere outside plugins/intercom/src/outbound.ts (and the tests
# that exercise it directly) bypasses the outbound email filter
# and re-opens the leak Caroline was disclosing on 2026-04-16.
# ---------------------------------------------------------------
echo "  [6/7] Intercom client construction"
# Staged files only — we don't care about pre-existing prod code until it gets
# touched. Include R (rename) so `git mv` can't smuggle a bypass past the check
# by carrying an existing `new RealIntercomClient(` through a rename.
staged_ts_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)
bypass_hits=()
bypass_errors=()
if [[ -n "$staged_ts_files" ]]; then
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    # Allow the real construction inside the factory itself and anywhere
    # under the plugin's test directory.
    case "$f" in
      plugins/intercom/src/outbound.ts) continue ;;
      plugins/intercom/tests/*) continue ;;
    esac
    # Read staged blob explicitly and check for read failure — otherwise a
    # `git show` error (index race, unusual path) silently becomes empty
    # stdin and the check passes by accident.
    if ! staged_content=$(git show ":$f" 2>/dev/null); then
      bypass_errors+=("$f")
      continue
    fi
    # Strip TS comments and string literals before grepping so a docstring
    # or error message containing the pattern doesn't false-positive — the
    # briefing explicitly tells devs not to `--no-verify`, and false
    # positives train the opposite reflex.
    #   - Line comments: // ...
    #   - Block comments: /* ... */  (single-line form covers JSDoc snippets)
    #   - Single/double-quoted strings, and backtick template literals
    stripped_content=$(printf '%s\n' "$staged_content" \
      | sed -E 's#//.*$##' \
      | sed -E 's#/\*.*\*/##g' \
      | sed -E "s/'[^']*'//g; s/\"[^\"]*\"//g; s/\`[^\`]*\`//g")
    if grep -qE 'new[[:space:]]+RealIntercomClient[[:space:]]*\(' <<<"$stripped_content"; then
      bypass_hits+=("$f")
    fi
  done <<< "$staged_ts_files"
fi
if (( ${#bypass_errors[@]} > 0 )); then
  fail "git show failed for staged file(s) — refusing to commit:"
  for f in "${bypass_errors[@]}"; do red "      $f"; done
fi
if (( ${#bypass_hits[@]} > 0 )); then
  fail "direct RealIntercomClient construction found in:"
  for f in "${bypass_hits[@]}"; do red "      $f"; done
  cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    `new RealIntercomClient(...)` bypasses SanitizingIntercomClient,
    which is the only thing stopping Caroline from leaking arbitrary
    @muso.ai email addresses into customer-facing Intercom replies.
    Bypassing the wrapper is a prod incident class — see
    docs/designs/2026-04-17-cs-agent-email-guardrail-design.md for history.

  HOW TO FIX (do this — do NOT --no-verify):
    Replace:
      new RealIntercomClient(token)
    with:
      createIntercomClient(token, log)   // log optional
    Import from ./outbound.js.

  WHEN BYPASSING IS OK:
    Inside outbound.ts itself (the factory) or anywhere under
    plugins/intercom/tests/. Those paths are already allowlisted
    above. Comment/string occurrences of the pattern are stripped
    before grepping, so docstrings and error messages are fine.
  ──────────────────────────────────────────────────────────────────
BRIEFING
else
  ok "no direct RealIntercomClient construction outside allowed paths"
fi

# ---------------------------------------------------------------
# Check 7: no em-dashes (U+2014) in Caroline's customer-facing surface
# The analytics-tone rule (SOUL.md, common-issues.md §7) requires
# en-dashes only across workspaces/support/, skills-all/muso-intercom/,
# and every workspaces/<agent>/skills/muso-intercom/ mirror. The lint
# script does dynamic mirror discovery so a new agent copy can't slip
# past — see scripts/lint-no-em-dash.sh.
# ---------------------------------------------------------------
echo "  [7/7] no em-dashes in customer-facing surface"
staged_caroline_files=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(workspaces/support/|skills-all/muso-intercom/|workspaces/[^/]+/skills/muso-intercom/)' \
  || true)
if [[ -z "$staged_caroline_files" ]]; then
  ok "no staged Caroline-surface files; skipping em-dash scan"
else
  if bash scripts/lint-no-em-dash.sh > /tmp/em-dash-lint.$$ 2>&1; then
    ok "no em-dashes in staged Caroline surface"
    rm -f /tmp/em-dash-lint.$$
  else
    fail "em-dash(es) found in customer-facing knowledge base:"
    sed 's/^/      /' /tmp/em-dash-lint.$$
    rm -f /tmp/em-dash-lint.$$
    cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    The analytics-tone rule (SOUL.md, common-issues.md §7) requires
    en-dashes (U+2013, `–`) only in Caroline's customer-facing surface.
    Em-dashes (U+2014, `—`) are a forbidden character class — Caroline
    learns voice from these files and would otherwise mirror them in
    customer replies. Past sweeps have been undone by single-file edits
    that didn't get re-linted.

  HOW TO FIX (do this — do NOT --no-verify):
    1. Open each file printed above and replace `—` (em-dash) with
       `–` (en-dash). On macOS: `perl -i -pe 's/\x{2014}/\x{2013}/g' <file>`
    2. Re-run: `bash scripts/lint-no-em-dash.sh`
    3. Re-stage and retry the commit.

  WHEN BYPASSING IS OK:
    Never. There are no legitimate em-dashes in this surface.
  ──────────────────────────────────────────────────────────────────
BRIEFING
  fi
fi

echo
if (( fail_count > 0 )); then
  red "✗ pre-commit failed ($fail_count check(s) failed)"
  yellow "  bypass with --no-verify only in true emergencies"
  exit 1
fi
green "✓ pre-commit passed"
