          # and predicates, so `find /tmp -name rsync -print` names a FILE and
          # runs nothing. Demoting find out of the wrapper list alone was not
          # enough -- the scan then stopped AT find and never reached -exec.
          if (w ~ "(^|/)(" otool ")$") { scanon = 1; continue }
          if (scanon && !sawwrap) { if (w ~ execslot) sawwrap = 1; continue }
          if (w ~ /(^|\/)rsync$/) return w
