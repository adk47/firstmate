          # literal evals away, so anything reaching here is indirection the
          # gate cannot inspect, and it refuses rather than passing silently.
          if (w ~ /(^|\/)eval$/) { indirection++; return "" }
          if (!sawwrap) return w
          # Past a wrapper, options and their operands are indistinguishable
          # without each wrapper option table (`sudo -u nobody -g nogroup` has
          # two, `time -p` has none), so scan on until the wrapped command
          # word is found rather than guessing how many to skip. A wrapper
          # line whose target is rsync is therefore always judged.
