echo "  [5/7] SOUL.md hardcoded model names (issue #117)"
staged_soul=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^workspaces/[^/]+/SOUL\.md$' || true)
if [[ -z "$staged_soul" ]]; then
