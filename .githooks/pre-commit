#!/usr/bin/env bash
# HYDRA pre-commit hook
# =====================
# Static invariants that must hold before every commit. Runs offline, no network.
# Install: scripts/setup-hooks.sh (or: git config core.hooksPath .githooks)
#
# READ THIS BEFORE BYPASSING WITH --no-verify:
# Each failing check below prints a multi-line briefing explaining what
# the check protects, what will break in production if you skip it, and
# the exact steps to fix the underlying problem instead of bypassing.
# --no-verify is a footgun. Use it only after reading the briefing and
# confirming the fix is genuinely impossible right now.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

red()   { printf '\033[0;31m%s\033[0m\n' "$*"; }
green() { printf '\033[0;32m%s\033[0m\n' "$*"; }
yellow(){ printf '\033[0;33m%s\033[0m\n' "$*"; }

fail_count=0
fail() { red "  ✗ $*"; fail_count=$((fail_count+1)); }
ok()   { green "  ✓ $*"; }

echo "→ hydra pre-commit checks"

# nullglob: empty/missing skills-all/ should produce zero loop iterations,
# not a literal `skills-all/*/` token that the [[ -d ]] guard then skips.
shopt -s nullglob

# ---------------------------------------------------------------
# Check 1: every skills-all/<skill>/ has a SKILL.md
# ---------------------------------------------------------------
echo "  [1/3] skills-all structure"
if [[ ! -d skills-all ]]; then
  fail "skills-all/ directory missing — refusing to commit (this would silently 'pass' an empty skill set)"
fi
missing_skill_md=()
skill_count=0
for d in skills-all/*/; do
  [[ -d "$d" ]] || continue
  skill_count=$((skill_count + 1))
  if [[ ! -f "${d}SKILL.md" ]]; then
    missing_skill_md+=("$d")
  fi
done
if (( skill_count == 0 )); then
  fail "skills-all/ contains zero skills — refusing to commit (something deleted all of them?)"
elif (( ${#missing_skill_md[@]} > 0 )); then
  fail "skills missing SKILL.md:"
  for s in "${missing_skill_md[@]}"; do red "      $s"; done
  cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    Every directory under skills-all/ MUST have a SKILL.md or the
    openclaw runtime can't load the skill. A skill dir without SKILL.md
    is dead weight at best, a load-time crash at worst.

  HOW TO FIX (do this — do NOT --no-verify):
    1. For each path above, either:
       (a) Create the missing SKILL.md (frontmatter + body), OR
       (b) Delete the empty/broken directory entirely:
             git rm -r skills-all/<name>/
    2. Re-stage and retry the commit.

  WHEN BYPASSING IS OK:
    Almost never. The commit will land but the skill is broken until
    fixed. If you bypass, open an issue immediately.
  ──────────────────────────────────────────────────────────────────
BRIEFING
else
  ok "all $skill_count skills have SKILL.md"
fi

# ---------------------------------------------------------------
# Check 2: deploy.sh carries the required runtime-data excludes
# These paths hold server-only state (dispute trackers, api logs)
# that --delete would wipe out. The excludes live in a shared
# RSYNC_EXCLUDES array — we assert:
#   (a) each required exclude is declared (in code, not in a comment)
#   (b) at least one rsync call exists, and EVERY rsync call references
#       the shared array (so a future "I'll just call rsync directly"
#       can't accidentally bypass the excludes)
# ---------------------------------------------------------------
echo "  [2/3] deploy.sh safety excludes"
DEPLOY_SH="scripts/deploy.sh"
required_excludes=(
  "workspaces/*/memory/"
  "workspaces/*/api-logs/"
  "workspaces/*/reports/"
  "workspaces/*/.openclaw/"
  "workspaces/*/IDENTITY.md"
  "workspaces/*/HEARTBEAT.md"
  "audit/"
  "audit-local-backup/"
  "config/"
  "plugins/*/node_modules/"
  "plugins/*/package-lock.json"
)
if [[ ! -f "$DEPLOY_SH" ]]; then
  fail "$DEPLOY_SH not found"
else
  # Strip shell comments and heredoc bodies before structural greps.
  # Without this, a commented-out --exclude line ('# --exclude=...')
  # silently passes the check, AND words like "rsync" appearing in
  # briefing heredocs inflate the rsync call counter.
  #
  # Comment stripping: only WHOLE-LINE comments (^[[:space:]]*#.*$).
  # We do NOT strip inline trailing '# ...' on code lines — the awk
  # below uses sub() with a leading-anchor regex, not a mid-line one,
  # because correctly handling '#' inside quoted strings is hard. This
  # is fine because the required_excludes match against the full
  # --exclude='pat' literal — a real --exclude line can't sit after a
  # trailing '#' on the same line and still be syntactically valid.
  #
  # Heredoc stripping: drop lines between the opener (`<<[-]?[ws]*MARKER`)
  # and a line equal to MARKER. We keep the opener line so structural
  # counters still see whatever code preceded the heredoc on that line.
  # The opener regex permits whitespace between `<<` and the marker
  # (e.g. `bash << 'POSTSYNC'`) — without this, deploy.sh's POSTSYNC
  # heredoc body would flow through unstripped, re-creating the exact
  # silent-bypass class this preprocessor was meant to close.
  deploy_code=$(awk '
    BEGIN { in_heredoc = 0; marker = "" }
    {
      if (in_heredoc) {
        if ($0 == marker) { in_heredoc = 0; marker = "" }
        next
      }
      # detect <<MARKER, << MARKER, <<-MARKER, << '"'"'MARKER'"'"', <<"MARKER", etc.
      # The regex permits optional `-`, optional whitespace, optional
      # quote (single or double), then the marker word, then matching quote.
      if (match($0, /<<-?[[:space:]]*['"'"'"]?[A-Za-z_][A-Za-z0-9_]*['"'"'"]?/)) {
        m = substr($0, RSTART, RLENGTH)
        gsub(/^<<-?[[:space:]]*['"'"'"]?/, "", m)
        gsub(/['"'"'"]$/, "", m)
        in_heredoc = 1
        marker = m
        print  # keep the opening line so structural counters still see it
        next
      }
      # strip whole-line comments
      sub(/^[[:space:]]*#.*$/, "")
      print
    }
  ' "$DEPLOY_SH")

  missing_excludes=()
  for pat in "${required_excludes[@]}"; do
    if ! grep -qF -- "--exclude='$pat'" <<<"$deploy_code"; then
      missing_excludes+=("$pat")
    fi
  done
  if (( ${#missing_excludes[@]} > 0 )); then
    fail "deploy.sh missing required --exclude patterns:"
    for p in "${missing_excludes[@]}"; do red "      --exclude='$p'"; done
  fi

  # Count rsync invocations (in code, not comments) and array refs.
  # The regex must match both bare invocations (`rsync -a ...` at line
  # start) AND command-substitution patterns (`dry_out=$(rsync -an ...`).
  # We anchor on `rsync ` followed by a flag (`-`) so it never matches
  # the word "rsync" in prose, then rely on the comment-stripped
  # `deploy_code` to avoid matching documentation text.
  # We require: ≥1 rsync call AND every rsync call references the array.
  rsync_calls=$(grep -cE '(^|[[:space:]]|\()rsync -' <<<"$deploy_code") || rsync_calls=0
  rsync_with_excludes=$(grep -cF '"${RSYNC_EXCLUDES[@]}"' <<<"$deploy_code") || rsync_with_excludes=0
  if (( rsync_calls == 0 )); then
    fail "deploy.sh contains zero rsync calls — something is very wrong"
  elif (( rsync_with_excludes != rsync_calls )); then
    fail "deploy.sh has $rsync_calls rsync call(s) but $rsync_with_excludes reference \${RSYNC_EXCLUDES[@]} (must match exactly)"
  fi

  if (( ${#missing_excludes[@]} > 0 )) || (( rsync_calls == 0 )) || (( rsync_with_excludes != rsync_calls )); then
    cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    scripts/deploy.sh runs `rsync --delete` from this repo to
    /opt/hydra/ on node-8. Anything on the server that isn't in the
    repo gets WIPED unless --exclude protects it. The required list
    above covers paths we've confirmed contain real production state:
      • workspaces/*/memory/        → dispute trackers, scan results
      • workspaces/*/api-logs/      → audit trail of external API calls
      • workspaces/*/reports/       → generated reports (CSVs/PDFs/JSON
                                      from agent runs — often PII)
      • workspaces/*/.openclaw/     → runtime workspace state
      • workspaces/*/IDENTITY.md    → agent identity (server-owned)
      • workspaces/*/HEARTBEAT.md   → liveness signal
      • audit/                      → per-workspace memory snapshots, conv logs
      • config/                     → CD-managed shadow mirror of the
                                      entire repo (16MB), written by
                                      GitHub Actions. scripts/deploy.sh
                                      and the GH Actions CD are TWO
                                      independent deploy paths — never
                                      let one wipe the other.
      • audit-local-backup/         → 8.6MB pre-existing backup of memory
                                      snapshots (node-8, 2026-04-07,
                                      from the audit/ migration)
      • plugins/*/node_modules/     → server-side npm install artifacts
      • plugins/*/package-lock.json

    If deploy.sh stops excluding any of these, the next deploy
    silently destroys live data. There is no backup.

  HOW TO FIX (do this — do NOT --no-verify):
    1. Open scripts/deploy.sh
    2. Find the RSYNC_EXCLUDES=( ... ) array near the top of the file
       (it's hoisted there because Step 0 also reads it)
    3. Add the missing --exclude='...' line(s) listed above to the array
    4. Make sure every rsync invocation still uses "${RSYNC_EXCLUDES[@]}"
       (this hook checks that automatically — there are 6 rsync calls
       in deploy.sh today: dry-runs in Step 0 and Step 4a, real syncs
       in Step 4b, each in a local + remote variant)
    5. Re-run: bash .githooks/pre-commit

  IF YOU INTENTIONALLY REMOVED AN EXCLUDE:
    You must also remove it from required_excludes=( ... ) in this
    pre-commit script. But before you do that, prove the path is empty
    on the server (uses the same SSH defaults as deploy.sh — see the
    SSH config block at the top of scripts/deploy.sh):
      ssh -i "$SSH_KEY" "$NODE8_USER@$NODE8_IP" 'ls -la /opt/hydra/<path>'
    If it's not empty, you'll wipe data. Don't do it.

  WHEN BYPASSING IS OK:
    Never. This check exists because we already lost data this way.
  ──────────────────────────────────────────────────────────────────
BRIEFING
  else
    ok "required excludes present, all $rsync_calls rsync call(s) use shared array"
  fi
fi

# ---------------------------------------------------------------
# Check 3: no newly-staged files under runtime-data paths
# (prevents someone accidentally committing a dispute-tracker snapshot
# or api-log dump pulled from the server)
# ---------------------------------------------------------------
echo "  [3/3] staged files not under runtime-data paths"
staged=$(git diff --cached --name-only --diff-filter=A)
# Block paths that are 100% server-owned. We deliberately do NOT block
# IDENTITY.md / HEARTBEAT.md / .openclaw — those are mixed (some workspaces
# track them as seeds, others don't), so blocking would create false fails.
blocked_patterns='^(workspaces/[^/]+/(memory|api-logs|reports)|audit)/'
if [[ -n "$staged" ]]; then
  violations=$(echo "$staged" | grep -E "$blocked_patterns" || true)
  if [[ -n "$violations" ]]; then
    fail "runtime-data paths must not be committed:"
    while IFS= read -r v; do red "      $v"; done <<< "$violations"
    cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    The paths above hold live data that the server owns:
      • workspaces/*/memory/   accumulating state (dispute trackers, etc)
      • workspaces/*/api-logs/ rolling audit logs
      • audit/                 per-workspace memory snapshots, conv logs

    These are gitignored. If they end up staged, it usually means
    someone copied them down from node-8 (e.g. via rsync) and ran
    `git add -f` or `git add -A`. Committing a snapshot here:
      • forks the data — repo and server diverge
      • can leak sensitive customer data into git history
      • ages instantly (the snapshot is wrong by tomorrow)

  HOW TO FIX (do this — do NOT --no-verify):
    1. Unstage the offending files:
         git restore --staged <path>
    2. If you actually wanted to look at the data, leave it on disk
       (it stays gitignored) but don't commit it.
    3. If you genuinely need a snapshot in the repo for a one-off
       investigation, put it under docs/local/ instead — that path is
       gitignored and won't trigger this check.

  WHEN BYPASSING IS OK:
    Never via --no-verify. If the file genuinely belongs in the repo,
    update the blocked_patterns regex in this hook AND .gitignore in
    the same commit, and explain why in the commit message.
  ──────────────────────────────────────────────────────────────────
BRIEFING
  else
    ok "no staged files under runtime-data paths"
  fi
else
  ok "no newly-added files to check"
fi

echo
if (( fail_count > 0 )); then
  red "✗ pre-commit failed ($fail_count check(s) failed)"
  yellow "  bypass with --no-verify only in true emergencies"
  exit 1
fi
green "✓ pre-commit passed"
