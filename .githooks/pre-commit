#!/usr/bin/env bash
# HYDRA pre-commit hook
# =====================
# Static invariants that must hold before every commit. Runs offline, no network.
# Install: scripts/setup-hooks.sh (or: git config core.hooksPath .githooks)
#
# READ THIS BEFORE BYPASSING WITH --no-verify:
# Each failing check below prints a multi-line briefing explaining what
# the check protects, what will break in production if you skip it, and
# the exact steps to fix the underlying problem instead of bypassing.
# --no-verify is a footgun. Use it only after reading the briefing and
# confirming the fix is genuinely impossible right now.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

red()   { printf '\033[0;31m%s\033[0m\n' "$*"; }
green() { printf '\033[0;32m%s\033[0m\n' "$*"; }
yellow(){ printf '\033[0;33m%s\033[0m\n' "$*"; }

fail_count=0
fail() { red "  ✗ $*"; fail_count=$((fail_count+1)); }
ok()   { green "  ✓ $*"; }

echo "→ hydra pre-commit checks"

# nullglob: empty/missing skills-all/ should produce zero loop iterations,
# not a literal `skills-all/*/` token that the [[ -d ]] guard then skips.
shopt -s nullglob

# ---------------------------------------------------------------
# Check 1: every skills-all/<skill>/ has a SKILL.md
# ---------------------------------------------------------------
echo "  [1/7] skills-all structure"
if [[ ! -d skills-all ]]; then
  fail "skills-all/ directory missing — refusing to commit (this would silently 'pass' an empty skill set)"
fi
missing_skill_md=()
skill_count=0
for d in skills-all/*/; do
  [[ -d "$d" ]] || continue
  skill_count=$((skill_count + 1))
  if [[ ! -f "${d}SKILL.md" ]]; then
    missing_skill_md+=("$d")
  fi
done
if (( skill_count == 0 )); then
  fail "skills-all/ contains zero skills — refusing to commit (something deleted all of them?)"
elif (( ${#missing_skill_md[@]} > 0 )); then
  fail "skills missing SKILL.md:"
  for s in "${missing_skill_md[@]}"; do red "      $s"; done
  cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    Every directory under skills-all/ MUST have a SKILL.md or the
    openclaw runtime can't load the skill. A skill dir without SKILL.md
    is dead weight at best, a load-time crash at worst.

  HOW TO FIX (do this — do NOT --no-verify):
    1. For each path above, either:
       (a) Create the missing SKILL.md (frontmatter + body), OR
       (b) Delete the empty/broken directory entirely:
             git rm -r skills-all/<name>/
    2. Re-stage and retry the commit.

  WHEN BYPASSING IS OK:
    Almost never. The commit will land but the skill is broken until
    fixed. If you bypass, open an issue immediately.
  ──────────────────────────────────────────────────────────────────
BRIEFING
else
  ok "all $skill_count skills have SKILL.md"
fi

# ---------------------------------------------------------------
# Check 2: deploy.sh carries the required runtime-data excludes
# These paths hold server-only state (dispute trackers, api logs)
# that --delete would wipe out. The excludes live in a shared
# RSYNC_EXCLUDES array — we assert:
#   (a) each required exclude is declared (in code, not in a comment)
#   (b) at least one rsync call exists, and EVERY rsync call references
#       the shared array (so a future "I'll just call rsync directly"
#       can't accidentally bypass the excludes)
# ---------------------------------------------------------------
# Shell token classes shared by BOTH scanners below: the preprocessor decides
# whether a line executes an interpreter, and the detector decides whether a
# command is rsync. They ask the same structural question, and every time they
# were maintained separately they drifted -- wrapper operands (round 10 vs 20),
# first-command-only (21), keyword prefixes (22). One definition, passed to
# both awk programs, is what stops that recurring.
HOOK_KEYWORDS='if|then|elif|else|do|while|until|!'
HOOK_WRAPPERS='command|exec|sudo|doas|su|runuser|nohup|setsid|unshare|chroot|time|timeout|env|nice|ionice|stdbuf|xargs|flock|watch|strace|coproc|builtin'
# `find` is NOT in that list. Every wrapper above ALWAYS executes the command
# after it, so scanning on past its options is right. find does not: its
# operands are paths and predicates, and `find /tmp -name rsync -print` names
# a FILE. Treating find as a wrapper made that operand read as an rsync call
# and rejected a correct commit (QA finding 41) -- the outage class this check
# exists to fix. find only executes at an explicit action primary, so that is
# what opens a command slot.
HOOK_EXECSLOT='^-(exec|execdir|ok|okdir)$'
# Tools that KEEP SCANNING but whose words are operands until an action
# primary above opens a command slot.
HOOK_OPERAND_TOOLS='find'
# The destructive rsync flags this whole check exists to police. A
# reviewed-indirection marker may say "this unresolvable command word is fine";
# it may NEVER say "this command that deletes is fine", because that is the one
# assertion the gate is here to refuse. `reccomment` is computed per RECORD, so
# without this a marker anywhere on a line authorised every command on it, and
# `cmd=rsync; $cmd -az --delete ./ live/; gh release download v1  # marker`
# passed (QA finding 42). Prefix-matched so --del, --delete-after,
# --delete-during and --delete-excluded are all covered without listing them.
HOOK_DESTRUCTIVE='(^|[[:space:]])--(del|remove-source-files)'
# An OPTION whose own spelling is an expansion. `--$suffix` constructs
# --delete at run time, so matching only the literal flag above left the
# marker authorising a destructive sync it could not see (QA finding 43).
# Narrow on purpose: the finding asked to refuse a marked site whose argv
# carries ANY expansion, but measured against deploy.sh that refuses 16 of its
# 19 marked lines (`if $HYDRA_LOCAL`, `"$LINT_OPENCLAW_CFG" "${targets[@]}"`,
# `--pattern "$asset"`) and recreates the commit-blocking outage. deploy.sh
# spells zero options dynamically, so refusing THAT costs nothing and still
# refuses the construction the finding demonstrates.
HOOK_DYNOPT='(^|[[:space:]])"?-{1,2}[^[:space:]]*[$`]'
# What counts as a PLAIN WORD inside quotes. Quoting a command name does not
# stop it executing, so `"rsync" -a ...` and `"bash" -c ...` are real calls --
# but a quoted span holding an expansion, a space or a metacharacter is data.
# Shared for the same reason as the lists above: round 24 fixed this in the
# detector and round 25 found the identical hole still open in the
# preprocessor, because the rule lived in two places.
HOOK_PLAINWORD='^[A-Za-z0-9_./-]+$'
# A leading REDIRECTION word, which may precede the command: 2>err, >out, <in,
# &>both, 2>>log. Shared for the same reason as the classes above -- cmdword()
# has skipped these since round 26 and interp_cmd() did not, which is finding
# 32b and the sixth time one rule lived in two places.
HOOK_REDIR='^([0-9]*|&)(<|>)'
echo "  [2/7] deploy.sh safety excludes"
DEPLOY_SH="scripts/deploy.sh"
# This list is the enforced SUBSET of deploy.sh's RSYNC_EXCLUDES. The
# check is one-directional: it asserts every entry below is present in
# RSYNC_EXCLUDES, so removing a load-bearing protection from deploy.sh
# fails the commit. It deliberately omits repo-hygiene entries like
# .git, .deployed-sha, and hydra docs/ which are in RSYNC_EXCLUDES for
# other reasons (not data-loss protection). If you add a new exclude
# to deploy.sh that protects live server state, add it here too.
required_excludes=(
  "workspaces/*/memory/"
  "workspaces/*/api-logs/"
  "/api-logs/"
  "workspaces/*/MEMORY.md"
  "workspaces/*/backups/"
  "workspaces/*/reports/"
  "workspaces/*/.openclaw/"
  "workspaces/*/IDENTITY.md"
  "workspaces/*/HEARTBEAT.md"
  "workspaces/*/TOOLS.md"
  "workspaces/*/TOOLS.md.bak-*"
  "workspaces/*/*.md.bak-*"
  "workspaces/*/*.jpeg"
  "workspaces/*/*.jpg"
  "workspaces/*/*.webp"
  "workspaces/*/*.gif"
  "workspaces/*/*.pdf"
  "workspaces/*/intercom/"
  "workspaces/*/skills/gog/"
  "workspaces/*/skills/_archive/"
  "workspaces/*/skills/*/references/*-knowledge-base.md"
  "workspaces/*/write-activity.log"
  "workspaces/*/*.csv"
  "workspaces/*/.*pr-review-*.json"
  "workspaces/*/*_MANIFEST_*.md"
  "workspaces/*/.ops-*.json"
  "secrets/"
  "audit/"
  "audit-local-backup/"
  "config/"
  "plugins/*/node_modules/"
  "plugins/*/package-lock.json"
  "scripts/hydra-heal.sh"
  "workspaces/cmo/parent-companies.md"
  ".admin-token-cache"
  ".ads-token-cache"
  "workspaces/*/.env"
  "workspaces/*/pending-tickets/"
  "workspaces/*/*.png"
  "workspaces/*/media/"
  "workspaces/*/generated/"
  "workspaces/*/presentations/"
  "workspaces/*/exports/"
  "workspaces/*/research/"
  "workspaces/*/wiki/"
  "workspaces/*/*.txt"
  "workspaces/*/*.sql"
  "workspaces/*/*.sh"
  "workspaces/*/.bridge-*.json"
  "workspaces/*/.agent-bridge-*.json"
  "workspaces/*/bridge-request-*.json"
  "workspaces/*/bridge-*.json"
  "workspaces/*/skills/*/references/daily-batches/"
  "workspaces/*/tmp/"
  "workspaces/*/state/"
  "workspaces/*/scripts/"
  "__pycache__/"
  ".ruff_cache/"
  "*.pyc"
  "workspaces/*/.wrangler/"
  "workspaces/support/reference/hc-*.md"
  "workspaces/support/reference/hc-manifest.json"
)
if [[ ! -f "$DEPLOY_SH" ]]; then
  fail "$DEPLOY_SH not found"
else
  # Strip shell comments and heredoc bodies before structural greps.
  # Without this, a commented-out --exclude line ('# --exclude=...')
  # silently passes the check, AND words like "rsync" appearing in
  # briefing heredocs inflate the rsync call counter.
  #
  # Comment stripping: only WHOLE-LINE comments (^[[:space:]]*#.*$).
  # We do NOT strip inline trailing '# ...' on code lines — the awk
  # below uses sub() with a leading-anchor regex, not a mid-line one,
  # because correctly handling '#' inside quoted strings is hard. This
  # is fine because the required_excludes match against the full
  # --exclude='pat' literal — a real --exclude line can't sit after a
  # trailing '#' on the same line and still be syntactically valid.
  #
  # Heredoc stripping: drop lines between the opener (`<<[-]?[ws]*MARKER`)
  # and a line equal to MARKER. We keep the opener line so structural
  # counters still see whatever code preceded the heredoc on that line.
  # The opener regex permits whitespace between `<<` and the marker
  # (e.g. `bash << 'POSTSYNC'`) — without this, deploy.sh's POSTSYNC
  # heredoc body would flow through unstripped, re-creating the exact
  # silent-bypass class this preprocessor was meant to close.
  # LC_ALL=C: these awk programs scan byte by byte and rely on blank() being
  # LENGTH-PRESERVING so offsets index the original record. Byte semantics make
  # that exact, and identical on BSD awk and gawk; in a UTF-8 locale BSD awk
  # also aborts with "towc: multibyte conversion failure" on this file.
  deploy_code=$(LC_ALL=C awk -v sq="'" -v dq='"' -v kw="$HOOK_KEYWORDS" -v wrap="$HOOK_WRAPPERS" -v plainw="$HOOK_PLAINWORD" -v redir="$HOOK_REDIR" -v execslot="$HOOK_EXECSLOT" -v otool="$HOOK_OPERAND_TOOLS" -v destructive="$HOOK_DESTRUCTIVE" -v dynopt="$HOOK_DYNOPT" '
    # Position of the first `<<` that is genuinely a redirect: outside quotes,
    # and not the `<<<` of a here-string. Matching heredoc-looking text
    # anywhere on the line meant a quoted STRING containing <<DOC opened
    # heredoc state and swallowed the rest of the file (QA finding 14) --
    # while deploy.sh:2372 is `bash << POSTSYNC` with a QUOTED marker, so
    # quoted text near << cannot simply be ignored either.
    function hdpos(s,   n, i, c, q, esc) {
      n = length(s); q = ""; esc = 0
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (esc) { esc = 0; continue }
        if (q == sq) { if (c == sq) q = ""; continue }
        if (c == "\\") { esc = 1; continue }
        if (q == dq) { if (c == dq) q = ""; continue }
        if (c == sq || c == dq) { q = c; continue }
        if (c == "<" && substr(s, i + 1, 1) == "<") {
          if (substr(s, i + 2, 1) == "<") { i = i + 2; continue }
          return i
        }
      }
      return 0
    }
    # Split a line into shell WORDS, quote-aware. tk[i] is the word text with
    # quotes removed and double-quote escapes resolved; tkq[i] is the quote
    # character it was written in (empty if unquoted); ntk is the count.
    function toks(s,   n, i, c, q, cur, cq, started) {
      ntk = 0; n = length(s); i = 1
      while (i <= n) {
        while (i <= n && substr(s, i, 1) ~ /[[:space:]]/) i++
        if (i > n) break
        cur = ""; cq = ""; started = 0
        while (i <= n && (substr(s, i, 1) !~ /[[:space:]]/ || q != "")) {
          c = substr(s, i, 1)
          if (c == sq || c == dq) {
            if (cq == "") cq = c
            q = c; i++
            while (i <= n && substr(s, i, 1) != q) {
              if (q == dq && substr(s, i, 1) == "\\" && i < n) { cur = cur substr(s, i + 1, 1); i += 2; continue }
              cur = cur substr(s, i, 1); i++
            }
            i++; q = ""; started = 1; continue
          }
          cur = cur c; i++; started = 1
        }
        if (started) { ntk++; tk[ntk] = cur; tkq[ntk] = cq }
      }
    }
    # 1 when the COMMAND WORD of the line is a shell interpreter. Matching
    # interpreter name anywhere on the line instead made inert data
    # (`printf "%s" bash -c "..."`) read as an execution and reject a safe
    # commit -- the outage class this PR exists to fix (QA finding 19b).
    function interp_cmd(s,   i, sawwrap, scanon, iskip) {
      toks(s); sawwrap = 0
      for (i = 1; i <= ntk; i++) {
        # Redirections come FIRST: a heredoc redirect may be quoted
        # (`<<\047SCRIPT\047 bash`), and the data guard below would otherwise
        # reject it before the interpreter after it is ever seen (QA 33a).
        if (tk[i] ~ redir) { if (tk[i] ~ /^([0-9]*|&)(<|>)+$/) iskip = 1; continue }
        if (iskip) { iskip = 0; continue }                 # redirection target
        # A quoted word is data ONLY when it is not a plain word: quoting a
        # command name does not stop it executing (QA finding 25).
        if (tkq[i] != "" && tk[i] !~ plainw) return 0
        if (tk[i] ~ /^[A-Za-z_][A-Za-z0-9_]*=/) continue  # VAR=val prefix
        if (tk[i] ~ "^(" kw ")$") continue                 # keyword prefix
        if (tk[i] ~ "(^|/)(" wrap ")$") { sawwrap = 1; continue }
        # find is not a wrapper: keep scanning, but only its action primary
        # opens a command slot, so `find ... -exec bash -c` is still reached
        # while `find /tmp -name rsync` is not a call (QA 41).
        if (tk[i] ~ "(^|/)(" otool ")$") { scanon = 1; continue }
        if (scanon && !sawwrap) { if (tk[i] ~ execslot) sawwrap = 1; continue }
        # find is not a wrapper, so its action primary is what opens the slot.
        if (tk[i] ~ execslot) { sawwrap = 1; continue }
        if (tk[i] ~ /(^|\/)(bash|sh|zsh|ksh|dash)$/) return 1
        if (tk[i] ~ execslot) { sawwrap = 1; continue }
        if (!sawwrap) return 0
        # Past a wrapper, options and their operands are indistinguishable
        # without each wrapper option table (`sudo -u root` has one, `time -p`
        # none), so scan on to the wrapped command word instead of treating the
        # next token as it. Returning here classified `sudo -u root bash <<X`
        # as inert and discarded an executable heredoc (QA finding 20) -- the
        # same shape as the round-9 wrapper bug in the detector is cmdword().
        continue
      }
      return 0
    }
    # 1 when the & at position i is part of an fd-dup redirection (2>&1, <&0,
    # &>log) rather than a command separator. The DETECTOR has exempted this
    # since QA 31b; the PREPROCESSOR did not, so `2>&1 bash -c \047...\047` split
    # into `2>` and `1 bash -c ...`, interp_cmd() read the command word as
    # "1", and the literal script was never emitted for inspection
    # (QA finding 38). Same predicate, so the two halves cannot disagree.
    function fddup(s, i) {
      return (substr(s, i, 1) == "&" && (substr(s, i - 1, 1) ~ /[<>]/ || substr(s, i + 1, 1) == ">"))
    }
    # Start offset of the command segment that CONTAINS pos: the character
    # after the last control/grouping operator before it, skipping any that sit
    # inside quotes. Inspecting only the first command word of a line meant a
    # heredoc or -c script owned by a LATER command was classified inert
    # (QA finding 21).
    function seg_start(s, pos,   i, c, q, st) {
      st = 1; q = ""
      for (i = 1; i < pos && i <= length(s); i++) {
        c = substr(s, i, 1)
        if (q == sq) { if (c == sq) q = ""; continue }
        if (c == "\\") { i++; continue }
        if (q == dq) { if (c == dq) q = ""; continue }
        if (c == sq || c == dq) { q = c; continue }
        if (fddup(s, i)) continue
        if (c ~ /[;&|(){}]/) st = i + 1
      }
      return st
    }
    # End offset (exclusive) of the command segment containing pos: the first
    # control/grouping operator at or after it that is not inside quotes.
    # Pairs with seg_start() so a construct can be bound to its WHOLE owning
    # command, not just the text leading up to it.
    function seg_end(s, pos,   i, c, q) {
      q = ""
      for (i = pos; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (q == sq) { if (c == sq) q = ""; continue }
        if (c == "\\") { i++; continue }
        if (q == dq) { if (c == dq) q = ""; continue }
        if (c == sq || c == dq) { q = c; continue }
        if (fddup(s, i)) continue
        if (c ~ /[;&|(){}]/) return i
      }
      return length(s) + 1
    }
    # Every command-substitution body on the line, concatenated and prefixed
    # with separators so split_cmds() treats each as its own command.
    function subst_bodies(s,   i, c, q, depth, st, out) {
      q = ""; depth = 0; out = ""
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (depth > 0) {
          if (c == "(") depth++
          else if (c == ")") { depth--; if (depth == 0) out = out " ; " substr(s, st, i - st) }
          continue
        }
        if (q == sq) { if (c == sq) q = ""; continue }
        if (c == "\\") { i++; continue }
        if (q == dq && c != dq && !(c == "$" && substr(s, i + 1, 1) == "(")) continue
        if (c == "$" && substr(s, i + 1, 1) == "(") { depth = 1; st = i + 2; i++; continue }
        if (c == dq) { q = (q == dq ? "" : dq); continue }
        if (c == sq) { q = sq; continue }
      }
      return out
    }
    # Split a line into command segments at unquoted control/grouping
    # operators, filling segtext[1..n]. Same boundary set as seg_start().
    function split_cmds(s,   i, c, q, st, n) {
      n = 0; st = 1; q = ""
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (q == sq) { if (c == sq) q = ""; continue }
        if (c == "\\") { i++; continue }
        if (q == dq) { if (c == dq) q = ""; continue }
        if (c == sq || c == dq) { q = c; continue }
        if (fddup(s, i)) continue
        if (c ~ /[;&|(){}]/) { n++; segtext[n] = substr(s, st, i - st); st = i + 1 }
      }
      n++; segtext[n] = substr(s, st)
      return n
    }
    # The heredoc delimiter token that starts at hp. A delimiter is an ordinary
    # shell WORD, so it may contain punctuation (`DOC-END`, `EOF.1`) and may be
    # quoted. Accepting only [A-Za-z_][A-Za-z0-9_]* recorded `DOC` for
    # <<DOC-END, so the terminator never matched and every following command
    # was swallowed as heredoc body -- the gate silently switching itself off
    # (QA finding 23, same class as 13a and 14).
    function hdmarker(s, hp,   i, c, q, m) {
      i = hp + 2
      if (substr(s, i, 1) == "-") i++
      while (i <= length(s) && substr(s, i, 1) ~ /[[:space:]]/) i++
      # A delimiter is one shell WORD, and a word may be built from adjacent
      # quoted and unquoted fragments: <<\047DO\047C is terminated by DOC after
      # quote removal (QA finding 27a). Concatenate fragments rather than
      # stopping at the first one.
      m = ""
      while (i <= length(s) && substr(s, i, 1) !~ /[[:space:];&|<>()]/) {
        c = substr(s, i, 1)
        if (c == sq || c == dq) {
          q = c; i++
          while (i <= length(s) && substr(s, i, 1) != q) { m = m substr(s, i, 1); i++ }
          i++; continue
        }
        # Quote removal applies to UNQUOTED fragments only: `<<\\DOC` terminates
        # on DOC (QA 26b), but inside single quotes a backslash is literal, so
        # a quoted `DO\\C` delimiter keeps it (QA 33b). Stripping after the
        # scan removed both, and that heredoc then never closed.
        if (c == "\\" && i < length(s)) { m = m substr(s, i + 1, 1); i += 2; continue }
        m = m c; i++
      }
      return m
    }
    # Text of an actual trailing COMMENT, or "" if the line has none. The
    # reviewed-indirection marker is only honoured here: matching it anywhere
    # on the line let printed DATA containing the marker text switch the
    # refusal off (QA finding 29c).
    # The CODE half of a line: everything before an unquoted comment. Exact
    # complement of comment_text() below, so the two cannot disagree about
    # where a comment starts.
    function code_text(s,   i, c, q) {
      q = ""
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (q == sq) { if (c == sq) q = ""; continue }
        if (c == "\\") { i++; continue }
        if (q == dq) { if (c == dq) q = ""; continue }
        if (c == sq || c == dq) { q = c; continue }
        if (c == "#" && (i == 1 || substr(s, i - 1, 1) ~ /[[:space:];&|()]/)) return substr(s, 1, i - 1)
      }
      return s
    }
    # Hex digit value, or -1.
    function hexv(c,   p) { p = index("0123456789abcdef", tolower(c)); return p - 1 }
    # Decode a bash ANSI-C ($\047...\047) body. Sets ansi_bad=1 and returns ""
    # for anything it cannot decode, so the caller FAILS CLOSED rather than
    # passing a half-decoded string on.
    #
    # Enumerating escapes one incident at a time does not converge: \n and \t
    # (QA 33c), then hex and octal spellings (QA 35b), then the unicode
    # and control-char spellings (QA 40) -- each naming a separator the
    # previous list missed. So decode the whole grammar and refuse the
    # remainder, which bounds the class instead of extending the list again.
    function ansi_c(s,   i, n, c, d, v, k, out, digits, c2, ctl) {
      ansi_bad = 0; out = ""; n = length(s)
      ctl = "@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_"
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c != "\\") { out = out c; continue }
        d = substr(s, i + 1, 1)
        if (d == "n") { out = out "\n"; i++; continue }
        if (d == "t") { out = out "\t"; i++; continue }
        if (d == "r") { out = out "\r"; i++; continue }
        if (d == "a") { out = out sprintf("%c", 7);  i++; continue }
        if (d == "b") { out = out sprintf("%c", 8);  i++; continue }
        if (d == "f") { out = out sprintf("%c", 12); i++; continue }
        if (d == "v") { out = out sprintf("%c", 11); i++; continue }
        if (d == "e" || d == "E") { out = out sprintf("%c", 27); i++; continue }
        if (d == "\\" || d == sq || d == dq || d == "?") { out = out d; i++; continue }
        if (d == "x" || d == "u" || d == "U") {
          digits = (d == "x" ? 2 : (d == "u" ? 4 : 8))
          v = 0; k = 0
          while (k < digits && hexv(substr(s, i + 2 + k, 1)) >= 0) { v = v * 16 + hexv(substr(s, i + 2 + k, 1)); k++ }
          if (k == 0 || v == 0) { ansi_bad = 1; return "" }
          # Only ASCII can be a command separator; anything above is ordinary
          # text, and awk cannot render it portably.
