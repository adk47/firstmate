# ---------------------------------------------------------------
# Check 6: SanitizingIntercomClient bypass guard
# createIntercomClient() is the only sanctioned way to build an
# outbound Intercom client. Direct `new RealIntercomClient(...)`
# anywhere outside plugins/intercom/src/outbound.ts (and the tests
# that exercise it directly) bypasses the outbound email filter
# and re-opens the leak Caroline was disclosing on 2026-04-16.
# ---------------------------------------------------------------
echo "  [6/7] Intercom client construction"
# Staged files only — we don't care about pre-existing prod code until it gets
# touched. Include R (rename) so `git mv` can't smuggle a bypass past the check
# by carrying an existing `new RealIntercomClient(` through a rename.
staged_ts_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)
bypass_hits=()
bypass_errors=()
if [[ -n "$staged_ts_files" ]]; then
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    # Allow the real construction inside the factory itself and anywhere
    # under the plugin's test directory.
    case "$f" in
      plugins/intercom/src/outbound.ts) continue ;;
      plugins/intercom/tests/*) continue ;;
    esac
    # Read staged blob explicitly and check for read failure — otherwise a
    # `git show` error (index race, unusual path) silently becomes empty
    # stdin and the check passes by accident.
    if ! staged_content=$(git show ":$f" 2>/dev/null); then
      bypass_errors+=("$f")
      continue
    fi
    # Strip TS comments and string literals before grepping so a docstring
    # or error message containing the pattern doesn't false-positive — the
    # briefing explicitly tells devs not to `--no-verify`, and false
    # positives train the opposite reflex.
    #   - Line comments: // ...
    #   - Block comments: /* ... */  (single-line form covers JSDoc snippets)
    #   - Single/double-quoted strings, and backtick template literals
    stripped_content=$(printf '%s\n' "$staged_content" \
      | sed -E 's#//.*$##' \
      | sed -E 's#/\*.*\*/##g' \
      | sed -E "s/'[^']*'//g; s/\"[^\"]*\"//g; s/\`[^\`]*\`//g")
    if grep -qE 'new[[:space:]]+RealIntercomClient[[:space:]]*\(' <<<"$stripped_content"; then
      bypass_hits+=("$f")
    fi
  done <<< "$staged_ts_files"
fi
if (( ${#bypass_errors[@]} > 0 )); then
  fail "git show failed for staged file(s) — refusing to commit:"
  for f in "${bypass_errors[@]}"; do red "      $f"; done
fi
if (( ${#bypass_hits[@]} > 0 )); then
  fail "direct RealIntercomClient construction found in:"
  for f in "${bypass_hits[@]}"; do red "      $f"; done
  cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    `new RealIntercomClient(...)` bypasses SanitizingIntercomClient,
    which is the only thing stopping Caroline from leaking arbitrary
    @muso.ai email addresses into customer-facing Intercom replies.
    Bypassing the wrapper is a prod incident class — see
    docs/designs/2026-04-17-cs-agent-email-guardrail-design.md for history.

  HOW TO FIX (do this — do NOT --no-verify):
    Replace:
      new RealIntercomClient(token)
    with:
      createIntercomClient(token, log)   // log optional
    Import from ./outbound.js.

  WHEN BYPASSING IS OK:
    Inside outbound.ts itself (the factory) or anywhere under
    plugins/intercom/tests/. Those paths are already allowlisted
    above. Comment/string occurrences of the pattern are stripped
    before grepping, so docstrings and error messages are fine.
  ──────────────────────────────────────────────────────────────────
BRIEFING
else
  ok "no direct RealIntercomClient construction outside allowed paths"
fi

# ---------------------------------------------------------------
# Check 7: no em-dashes (U+2014) in Caroline's customer-facing surface
# The analytics-tone rule (SOUL.md, common-issues.md §7) requires
# en-dashes only across workspaces/support/, skills-all/muso-intercom/,
# and every workspaces/<agent>/skills/muso-intercom/ mirror. The lint
# script does dynamic mirror discovery so a new agent copy can't slip
# past — see scripts/lint-no-em-dash.sh.
# ---------------------------------------------------------------
echo "  [7/7] no em-dashes in customer-facing surface"
staged_caroline_files=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(workspaces/support/|skills-all/muso-intercom/|workspaces/[^/]+/skills/muso-intercom/)' \
  || true)
if [[ -z "$staged_caroline_files" ]]; then
  ok "no staged Caroline-surface files; skipping em-dash scan"
else
  if bash scripts/lint-no-em-dash.sh > /tmp/em-dash-lint.$$ 2>&1; then
    ok "no em-dashes in staged Caroline surface"
    rm -f /tmp/em-dash-lint.$$
  else
    fail "em-dash(es) found in customer-facing knowledge base:"
    sed 's/^/      /' /tmp/em-dash-lint.$$
    rm -f /tmp/em-dash-lint.$$
    cat <<'BRIEFING'

  ── BRIEFING ──────────────────────────────────────────────────────
  WHY THIS CHECK EXISTS:
    The analytics-tone rule (SOUL.md, common-issues.md §7) requires
    en-dashes (U+2013, `–`) only in Caroline's customer-facing surface.
    Em-dashes (U+2014, `—`) are a forbidden character class — Caroline
    learns voice from these files and would otherwise mirror them in
    customer replies. Past sweeps have been undone by single-file edits
    that didn't get re-linted.

  HOW TO FIX (do this — do NOT --no-verify):
    1. Open each file printed above and replace `—` (em-dash) with
       `–` (en-dash). On macOS: `perl -i -pe 's/\x{2014}/\x{2013}/g' <file>`
    2. Re-run: `bash scripts/lint-no-em-dash.sh`
    3. Re-stage and retry the commit.

  WHEN BYPASSING IS OK:
    Never. There are no legitimate em-dashes in this surface.
  ──────────────────────────────────────────────────────────────────
BRIEFING
  fi
fi

# MUS-5643: no new literal /tmp/ scratch paths (trap-EXIT cannot clean agent shells)
echo "▸ no new /tmp scratch paths"
if [[ ! -f scripts/check-no-tmp-scratch.sh ]]; then
  ok "no /tmp scratch guard in this tree (synthetic fixture repo)"
elif tmp_out=$(bash scripts/check-no-tmp-scratch.sh --staged 2>&1); then
  ok "no new /tmp/ scratch paths"
else
  fail "new literal /tmp/ scratch path (use \${PAPERCLIP_RUN_SCRATCH_DIR:-\${TMPDIR:-/tmp}}/..., or '# tmp-ok: <reason>')"
  printf '%s\n' "$tmp_out"
fi

echo
if (( fail_count > 0 )); then
  red "✗ pre-commit failed ($fail_count check(s) failed)"
  yellow "  bypass with --no-verify only in true emergencies"
  exit 1
fi
green "✓ pre-commit passed"
