                "data_collection": "deny",
                "sort": "price",
                "quantizations": [
                  "fp8",
                  "bf16",
                  "fp16"
                ],
                "max_price": {
                  "prompt": 0.3,
                  "completion": 1.2
                },
                "ignore": [
