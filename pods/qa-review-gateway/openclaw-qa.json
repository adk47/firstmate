  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-6-sol",
        "fallbacks": [
          "openrouter/deepseek/deepseek-v4.1-flash-1017"
        ]
      },
      "thinkingDefault": "medium",
      "imageModel": {
        "primary": "codex/gpt-5.6-sol",
        "fallbacks": [
          "openrouter/google/gemini-3.5-flash",
          "openrouter/anthropic/claude-haiku-4.5"
        ]
      },
      "models": {
        "openai/gpt-5.6-sol": {
          "alias": "gpt-5p6-sol-codex"
        },
        "openai/gpt-5.6-luna": {
          "alias": "gpt-5p6-luna-codex"
        },
        "openrouter/openai/gpt-5.6-luna": {
          "alias": "gpt-5p6-luna"
        },
        "openrouter/anthropic/claude-opus-4.7": {
          "alias": "opus-4-7"
        },
        "openrouter/anthropic/claude-4.6-sonnet-20260217": {
          "alias": "sonnet"
        },
        "openrouter/anthropic/claude-haiku-4.5": {
          "alias": "haiku"
        },
        "openrouter/openai/gpt-5.5": {
          "alias": "gpt-5p5"
        },
        "openrouter/openai/gpt-5.4-mini": {
          "alias": "gpt-5p4-mini"
        },
        "openrouter/google/gemini-3.5-flash": {
          "alias": "gemini-flash"
        },
        "openai/gpt-6-sol": {
          "alias": "gpt-6-sol-codex"
        },
        "openai/gpt-6-luna": {
          "alias": "gpt-6-luna-codex"
        },
        "openrouter/openai/gpt-6-luna": {
          "alias": "gpt-6-luna"
        },
        "openrouter/anthropic/claude-haiku-5.5": {
          "alias": "haiku-5-5"
        }
      },
      "workspace": "/opt/hydra/workspaces/qa",
      "bootstrapMaxChars": 40000,
      "bootstrapTotalMaxChars": 120000,
      "compaction": {
        "mode": "default",
        "keepRecentTokens": 40000
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 4,
        "runTimeoutSeconds": 1800
      },
      "timeoutSeconds": 1200
    },
    "list": [
      {
        "id": "qa",
        "workspace": "/opt/hydra/workspaces/qa",
        "model": {
          "primary": "openai/gpt-6-sol",
          "fallbacks": [
            "openrouter/deepseek/deepseek-v4.1-flash-1017"
          ]
        },
        "thinkingDefault": "high",
        "tools": {
          "deny": [
            "process",
            "lobster",
            "nodes",
            "computer",
            "terminal"
          ]
        }
      }
    ]
  },
  "tools": {
    "exec": {
      "mode": "auto"
    },
    "deny": [
      "group:ui",
      "group:sessions",
      "group:automation",
      "group:messaging",
      "group:nodes",
      "group:media",
      "skill_workshop"
    ],
    "sessions": {
      "visibility": "self"
    },
    "agentToAgent": {
      "enabled": false
    },
    "web": {
      "search": {
        "enabled": true,
        "openaiCodex": {
          "enabled": true,
          "mode": "live"
        }
      }
    }
  },
  "plugins": {
    "allow": [
      "codex",
      "openrouter"
    ],
    "entries": {
      "codex": {
        "enabled": true,
        "config": {
          "appServer": {
            "turnCompletionIdleTimeoutMs": 300000
          }
        }
      },
      "openai": {
        "enabled": false
      },
      "openrouter": {
        "enabled": true
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "maintenance": {
      "mode": "enforce",
      "pruneAfter": "48h",
      "maxEntries": 10000,
      "resetArchiveRetention": "7d",
      "maxDiskBytes": "4gb",
      "highWaterBytes": "3gb"
    }
  },
  "messages": {
    "suppressToolErrors": true
  },
  "commands": {
    "native": false,
    "nativeSkills": "auto",
    "restart": false
  },
  "cron": {},
  "update": {
    "channel": "stable",
    "auto": {
      "enabled": false
    }
  }
}
