{
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "controlUi": {
      "enabled": false
    },
    "auth": {
      "mode": "token"
    },
    "tailscale": {
      "mode": "off"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": false
        }
      }
    }
  },
  "secrets": {
    "providers": {
      "hydra-secrets": {
        "source": "file",
        "path": "/opt/hydra/secrets/llm-provider-keys.json",
        "mode": "json"
      },
      "hydra-env": {
        "source": "env",
        "allowlist": [
          "MUSO_SLACK_BOT_TOKEN_QA"
        ]
      }
    }
  },
  "auth": {
    "profiles": {},
    "order": {
      "openai": [
        "openai:aaron@muso.ai",
        "openai:aarondkaufman@gmail.com",
        "openai:aaronkaufman@me.com"
      ]
    }
  },
  "models": {
    "providers": {
      "openai": {
        "agentRuntime": {
          "id": "codex"
        },
        "models": [
          {
            "id": "gpt-5.6-sol",
            "name": "gpt-5.6-sol",
            "input": [
              "text",
              "image"
            ],
            "maxTokens": 128000,
            "reasoning": true,
            "contextWindow": 1050000
          },
          {
            "id": "gpt-5.6-luna",
            "name": "gpt-5.6-luna",
            "input": [
              "text",
              "image"
            ],
            "maxTokens": 128000,
