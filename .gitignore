# Dependencies
node_modules/
ui/node_modules/
ui/.next/

# Backups
openclaw-server-backup-*.json

# Environment
.env
.env.local
.env.production

# Secrets (never commit actual secrets)
#
# Fail-CLOSED: ignore everything in secrets/ and allow back only the one
# non-secret placeholder. This used to enumerate extensions (*.yaml, *.json),
# which silently let any other extension through — 2026-08-04 the Finance
# Mercury bank token moved into this dir as mercury.env and was therefore
# committable, in a change whose entire purpose was getting that credential
# OUT of a git repo. An allow-list of protected extensions is a privilege
# widening waiting to happen; the deny-everything form closes the class, so a
# future secrets/<anything> is covered without anyone remembering to add it.
secrets/*
!secrets/.gitkeep
qa-bot-app.json

# Any per-agent secret drop anywhere in the tree. The Mercury token leaked from
# workspaces/finance/.secrets/ specifically, and that path is matched by none of
# the rules above. NOTE this is a FILENAME guard, not a secret scanner — a token
# pasted into a skill, a doc, or a runbook is still committable; content
# scanning (gitleaks) is tracked separately.
**/.secrets/

# OS
.DS_Store
Thumbs.db

# Build
ui/out/
ui/.next/
plugins/*/dist/
*.tgz

# Extraction output (sensitive, gitignored by default)
extraction/*.md

# Editor
.vscode/
.idea/
plugins/openclaw-intercom/pnpm-lock.yaml

# Test files
test-intercom.html

# Superpowers (specs/plans are local working docs)
docs/superpowers/

# Local notes (not for version control)
docs/local/

# Worktrees
.worktrees/

# Workspace runtime data (server-only; see scripts/deploy.sh rsync excludes)
workspaces/*/memory/
workspaces/*/api-logs/
# Generated reports (CSVs / PDFs / JSON dumps from agent runs — often PII).
# Convention: agents write reports to workspaces/<agent>/reports/<filename>.
workspaces/*/reports/

# Workspace runtime artifacts (generated by agents on the server)
workspaces/*/*.csv
workspaces/*/*.png
workspaces/*/*.jpg
workspaces/*/*.txt
# Agent ad-hoc analytics SQL (see RSYNC_EXCLUDES in scripts/deploy.sh and
# KEEP_GLOBS in scripts/qa-clean-merge-scratch.sh -- the three lists describe
# the same runtime-artifact class from three directions: do not deploy-delete,
# do not sweep, do not commit).
workspaces/*/*.sql
workspaces/*/.bridge-*.json
workspaces/*/generated/
workspaces/*/presentations/
workspaces/*/exports/
workspaces/*/media/
workspaces/*/research/
workspaces/*/pending-tickets/
workspaces/*/.openclaw/
workspaces/*/skills/*/references/daily-batches/

# Per-workspace runtime state — flag files (EMAIL_SEND_HALT, etc),
# cron-runs.jsonl, send-ledger.jsonl, discovery-staging.jsonl, and other
# server-written state. Regenerated by agents on every run; tracking would
# create constant noise + private content leakage in commit history.
workspaces/*/state/
workspaces/*/skills/*/state/

# Per-workspace temporary scratch — agent-written batch CSVs, voice memo
# downloads (.m4a), one-off helper scripts, ad-hoc outputs. Anything an
# agent puts here is intended to be ephemeral.
workspaces/*/tmp/

# Server-side audit logs. The blanket `audit/` matches every audit dir
# in the tree, so negate the saved-queries/audit/ dir under
# muso-query-writer — those are committed SQL templates, not logs.
audit/
audit-local-backup/
!skills-all/muso-query-writer/saved-queries/audit/
!workspaces/**/skills/muso-query-writer/saved-queries/audit/

# CD-managed shadow mirror of the repo (server-side at /opt/hydra/config/,
# written by GitHub Actions — see scripts/deploy.sh comment for full context).
# Only top-level config/ is the shadow mirror; nested config/ dirs (e.g. inside
# skill bundles) are part of the repo and must NOT be ignored.
/config/
!skills-all/**/config/
!workspaces/**/config/

# Drift baseline (server-managed; written by deploy.sh after each push)
.deployed-sha

# Plugin install artifacts (installed on server, not in repo)
plugins/*/node_modules/
plugins/*/package-lock.json

# Runtime auth token caches (server-owned, ~23h JWTs). Written by
# muso-admin-api.sh and muso-ads-api.sh next to the script. Must
# never enter git — see RSYNC_EXCLUDES in scripts/deploy.sh for the
# deploy backstop and required_excludes in .githooks/pre-commit for
# the structural guard.
.admin-token-cache
.ads-token-cache

# CS analysis data (raw API dumps -- potentially PII, never commit)
scripts/cs-analysis/data/

# Python bytecode
__pycache__/
*.pyc

# Hot-patch timestamped backups (e.g. SKILL.md.bak.20260427T120838Z).
# Created on the live server during operator hot-patches. deploy.sh
# RSYNC_EXCLUDES has the deploy-side backstop; this entry is the
# git-side belt to match it.
*.bak.*

# Agent-generated audio rendered by skill scripts (currently
# cmo-onboarding-guide). Generators (.py) are tracked; rendered
# binaries are not — same pattern as a build artifact. deploy.sh
# RSYNC_EXCLUDES is the deploy-side backstop.
*.mp3

# Release notes scratch file. Written by scripts/release.sh between
# "draft" and "gh release create", removed on success. Only ever
# present mid-release on the operator's laptop.
RELEASE_NOTES_DRAFT.md
