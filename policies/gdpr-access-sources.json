{
  "_comment": "What a GDPR Art. 15 answer is built from (scripts/gdpr_pipeline/access.py). `sources` are the tables of the core database that hold rows keyed to an account, read on the read-only replica. Every column of a source is included unless it is listed under `withheld`. A table the replica shows with an account key that is listed neither here nor under `ignored`, a source whose key column has gone, and a column whose name looks like a secret and is neither `withheld` nor `reviewed`, each make the answer INCOMPLETE: it is recorded and never presented as the full copy. `systems` are the places outside the core database that hold personal data; one that is not covered makes the answer incomplete too. Adding a source, or marking a system covered, is a reviewed change to this file.",
  "v": 1,
  "row_ceiling": 20000,
  "discovery_columns": [
    "userid",
    "user_id",
    "accountid",
    "account_id",
    "ownerid",
    "owner_id",
    "createdby",
    "created_by",
    "email",
    "requesterid",
    "claimantid"
  ],
  "secret_like": "pass|token|secret|twofactor|hash|key|salt|otp|credential|arn",
  "withheld_reasons": {
    "credential": "A sign-in secret or an access token. It is held in a protected form and is not included, so that this file cannot be used to get into the account.",
    "another_person": "This field identifies another person (for example a member of staff). Article 15(4) of the GDPR says the right to obtain a copy \"shall not adversely affect the rights and freedoms of others\".",
    "unreviewed": "This field has not been reviewed for inclusion. It is left out of this file."
  },
  "ignored": {
    "pg_stat_statements": "a database statistics view; its userid is a database role, not an account"
  },
  "information_notice": {
    "text": "",
    "why_empty": "Article 15(1)(a) to (h) requires the purposes of the processing, the categories of data, the recipients, the storage period, the rights of the data subject, the right to complain, the source of the data and any automated decision-making to be given with the copy. That text is a legal statement. No approved text exists, so none is written here and every answer is incomplete until one is recorded in this field by a reviewed change."
  },
  "column_review": {
    "reviewed": false,
    "why_not": "The withheld list was written from column NAMES (a column named like a secret, or like a reference to another user). Nobody has read what the included columns hold. A free-text or JSON column can carry another person's data, and Article 15(4) says the copy \"shall not adversely affect the rights and freedoms of others\". Every answer is incomplete until this is set to true by a reviewed change that names who read the columns."
  },
