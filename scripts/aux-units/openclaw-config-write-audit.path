# Installed at: /etc/systemd/system/openclaw-config-write-audit.path
#
# Watches the three live openclaw configs for writes. When any of
# them changes, triggers openclaw-config-write-audit.service which
# captures the writer's PID/cmdline/exe and Slack-alerts if the
# writer isn't the gateway itself.
#
# Why: openclaw's own config-audit.jsonl only logs writes that go
# through the openclaw config-io module. Out-of-band writes (e.g.
# a script doing `jq … | sponge openclaw.json`) leave no trace —
# the 2026-05-05 outage was caused by exactly that class of write.
# This unit is the missing audit pathway. See the .service file
# and scripts/openclaw-config-write-audit.sh for the logger logic.
[Unit]
Description=Watch openclaw.json files for writes (out-of-band audit)

[Path]
PathChanged=/root/.openclaw-main/openclaw.json
PathChanged=/root/.openclaw-edge/openclaw.json
PathChanged=/root/.openclaw-dev/openclaw.json

[Install]
WantedBy=multi-user.target
