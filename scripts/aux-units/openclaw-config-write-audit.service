# Installed at: /etc/systemd/system/openclaw-config-write-audit.service
#
# Triggered by openclaw-config-write-audit.path. Runs the audit
# logger across all three openclaw.json paths in one pass (the
# .path unit doesn't tell us *which* of its watched paths fired
# without one .path per file, and the script's overhead with no
# writers to log is trivial). The logger Slack-alerts only when
# a non-gateway writer is identified.
[Unit]
Description=Audit openclaw.json writes and identify non-gateway writers

[Service]
Type=oneshot
ExecStart=/opt/hydra/scripts/openclaw-config-write-audit.sh
# A burst of writes (e.g. atomic-rename via tmp + rename) can fire
# the .path unit several times in quick succession. Coalesce:
# StartLimitBurst caps the number of starts and StartLimitIntervalSec
# defines the window. Lifting these from the gateway override.conf
# would defeat their purpose there, so set local-only here.
StartLimitBurst=10
StartLimitIntervalSec=60
