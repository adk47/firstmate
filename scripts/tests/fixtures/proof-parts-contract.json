{
  "_doc": "ONE proof-on-file completeness contract, tested from both sides: scripts/credit_review/verify_notify.load_proof_on_file, which applies proof_parts.py plus the entry and users checks (tests/test_proof_parts_contract.py) and Caroline's support tool plugins/support-tools/src/tools/proof-on-file.ts (tests/proof-on-file.test.ts). Each source's generated_at is rendered as now - age_h (or the literal generated_at if given; omitted when neither). The top-level generated_at is always now - 0.1h. entries and users default to [] and 0; a null users is left out of the document. expect: ok = authoritative, unknown = never ask, never remove. Captain via firstmate 035: strict; while cs-gmail is unusable EVERYONE is unknown, whatever gmail_contacts_90d says.",
  "cases": [
    {"name": "live shape: core has no stale key, intercom + gmail fresh",
     "sources": [{"name": "core", "age_h": 0.2, "count": 4980, "detail": {"verifications": 4943}},
                 {"name": "cs-intercom", "age_h": 0.8, "stale": false, "count": 78917, "coverage": "Intercom conversations 2021-01 onward"},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false, "count": 12}],
     "gmail_contacts_90d": {"generated_at_age_h": 0.5, "source": "cs-gmail scan", "user_ids": [34135]},
     "expect": "ok"},
    {"name": "exact legacy label is read as the Intercom part",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-systemic intercom+gmail", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "expect": "ok"},
    {"name": "an extra part that is not flagged does not matter",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}, {"name": "cs-whatsapp", "age_h": 30}],
     "expect": "ok"},
    {"name": "another cs-systemic name is NOT the Intercom part",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-systemic other", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "expect": "unknown"},
    {"name": "the old bare 'intercom' name is NOT the Intercom part",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "expect": "unknown"},
    {"name": "cs-gmail missing: everyone unknown, a contact list does not narrow it",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false}],
     "gmail_contacts_90d": {"generated_at_age_h": 0.1, "source": "cs-gmail scan", "user_ids": [34135]},
     "expect": "unknown"},
    {"name": "cs-gmail stale",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": true}],
     "expect": "unknown"},
    {"name": "a truthy non-boolean stale flag counts as stale",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": "true"},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "expect": "unknown"},
    {"name": "stale:false does not excuse an old stamp",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 5, "stale": false}],
     "expect": "unknown"},
    {"name": "core without a stamp",
     "sources": [{"name": "core"}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "expect": "unknown"},
    {"name": "core dated in the future",
     "sources": [{"name": "core", "age_h": -24}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "expect": "unknown"},
    {"name": "a naive (timezone-less) part stamp",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "generated_at": "2026-10-17T17:50:00", "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "expect": "unknown"},
    {"name": "a required part listed twice",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "core", "age_h": 0.3}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "expect": "unknown"},
    {"name": "any other part flagged stale or missing",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}, {"name": "cs-whatsapp", "missing": true}],
     "expect": "unknown"},
    {"name": "no sources at all",
     "sources": [],
     "expect": "unknown"},
    {"name": "well-formed entries with users equal to the distinct user ids",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": 111, "request_id": null, "kind": "pending_doc"}, {"user_id": "222", "request_id": "req-a", "kind": "approved_doc"}, {"user_id": 111, "kind": "human_approved_after_doc"}], "users": 2,
     "expect": "ok"},
    {"name": "a numeric and a string user id for the same user count once",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": 111, "request_id": null, "kind": "pending_doc"}, {"user_id": "111", "request_id": "req-a", "kind": "approved_doc"}], "users": 1,
     "expect": "ok"},
    {"name": "an entry that is not an object",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [42], "users": 0,
     "expect": "unknown"},
    {"name": "an entry with no user_id",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"request_id": null, "kind": "pending_doc"}], "users": 1,
     "expect": "unknown"},
    {"name": "an entry with a null user_id",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": null, "request_id": null, "kind": "pending_doc"}], "users": 1,
     "expect": "unknown"},
    {"name": "an entry with a blank user_id",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": "  ", "request_id": null, "kind": "pending_doc"}], "users": 1,
     "expect": "unknown"},
    {"name": "an entry with a boolean user_id",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": true, "request_id": null, "kind": "pending_doc"}], "users": 1,
     "expect": "unknown"},
    {"name": "an entry with a non-integer numeric user_id",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": 1.5, "request_id": null, "kind": "pending_doc"}], "users": 1,
     "expect": "unknown"},
    {"name": "an entry whose request_id is neither null nor a string",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": 111, "request_id": 5, "kind": "pending_doc"}], "users": 1,
     "expect": "unknown"},
    {"name": "an entry with an unknown kind",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": 111, "request_id": null, "kind": "maybe_doc"}], "users": 1,
     "expect": "unknown"},
    {"name": "an entry with no kind",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": 111, "request_id": null}], "users": 1,
     "expect": "unknown"},
    {"name": "users larger than the distinct user ids (half-written export)",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": 111, "request_id": null, "kind": "pending_doc"}], "users": 2,
     "expect": "unknown"},
    {"name": "users missing",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": 111, "request_id": null, "kind": "pending_doc"}], "users": null,
     "expect": "unknown"},
    {"name": "users not an integer",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": 111, "request_id": null, "kind": "pending_doc"}], "users": "1",
     "expect": "unknown"},
    {"name": "users a boolean",
     "sources": [{"name": "core", "age_h": 0.2}, {"name": "cs-intercom", "age_h": 0.8, "stale": false},
                 {"name": "cs-gmail", "age_h": 0.5, "stale": false}],
     "entries": [{"user_id": 111, "request_id": null, "kind": "pending_doc"}], "users": true,
     "expect": "unknown"}
