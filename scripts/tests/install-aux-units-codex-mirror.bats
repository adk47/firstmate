#!/usr/bin/env bats
# Wiring test for the codex edge auth-cell mirror units generated by
# scripts/install-aux-units.sh (>= 2026.8 branch). The installer as a whole
# writes real systemd units and clones repos, so — like
# install-aux-units-timer-guard.bats — this extracts ONE block and runs it
# against a temp unit dir (AUX_SYSTEMD_UNIT_DIR seam) with systemctl stubbed,
# then asserts the GENERATED unit/timer/OnFailure text. A static test also pins
# the block to the >= 2026.8 else-branch.
bats_require_minimum_version 1.5.0

HYDRA_REPO="$(cd "$(dirname "${BATS_TEST_FILENAME}")/../.." && pwd)"
INSTALLER="$HYDRA_REPO/scripts/install-aux-units.sh"
BLOCK_START='# ─── codex edge auth-cell mirror (timer, >= 2026.8 only) ───'
BLOCK_END='log "  $mtmr: $mstate'

setup() {
  TEST_TMPDIR="$(mktemp -d)"; export TEST_TMPDIR
  mkdir -p "$TEST_TMPDIR/bin" "$TEST_TMPDIR/units" "$TEST_TMPDIR/hydra/scripts/lib"
  export SYSTEMCTL_LOG="$TEST_TMPDIR/systemctl.log"
  cat > "$TEST_TMPDIR/bin/systemctl" <<'STUB'
#!/bin/bash
echo "$*" >> "$SYSTEMCTL_LOG"
[ "$1" = "is-active" ] && echo active
exit 0
STUB
  chmod +x "$TEST_TMPDIR/bin/systemctl"
  PATH="$TEST_TMPDIR/bin:$PATH"; export PATH
  export HYDRA_ROOT="$TEST_TMPDIR/hydra"
  printf '#!/bin/bash\nexit 0\n' > "$HYDRA_ROOT/scripts/lib/codex-edge-mirror.sh"
  printf '#!/bin/bash\nexit 0\n' > "$HYDRA_ROOT/scripts/notify-unit-failed.sh"
  chmod +x "$HYDRA_ROOT/scripts/lib/codex-edge-mirror.sh" "$HYDRA_ROOT/scripts/notify-unit-failed.sh"
  export AUX_SYSTEMD_UNIT_DIR="$TEST_TMPDIR/units"
  # Extract the block verbatim, prefixed with the helpers it uses.
  {
    echo 'set -euo pipefail'
    echo 'log() { echo "install-aux-units: $*"; }'
    echo 'fail() { log "FATAL: $*"; exit 1; }'
    echo 'AUX_RUNTIME_VER=2026.8.2'
    awk -v s="$BLOCK_START" -v e="$BLOCK_END" 'index($0,s){p=1} p{print} p && index($0,e){exit}' "$INSTALLER"
  } > "$TEST_TMPDIR/block.sh"
  [ "$(grep -c 'EDGEMIRRORTMR' "$TEST_TMPDIR/block.sh")" -eq 2 ] || { echo "block extraction failed" >&2; return 1; }
}
teardown() { rm -rf "$TEST_TMPDIR"; }

@test "the mirror block lives in the >= 2026.8 else-branch of the codex-refresh gate (static)" {
  gate=$(grep -n 'if \[ "$AUX_RUNTIME_IS_2026_8_PLUS" -eq 0 \]; then' "$INSTALLER" | head -1 | cut -d: -f1)
  els=$(awk -v g="$gate" 'NR>g && /^else$/ {print NR; exit}' "$INSTALLER")
  fi_=$(awk -v g="$els" 'NR>g && /^fi$/ {print NR; exit}' "$INSTALLER")
  blk=$(grep -n -F "$BLOCK_START" "$INSTALLER" | cut -d: -f1)
  [ -n "$gate" ] && [ -n "$els" ] && [ -n "$fi_" ] && [ -n "$blk" ]
  [ "$blk" -gt "$els" ] && [ "$blk" -lt "$fi_" ]
}

@test "generates codex-edge-mirror.service: ExecStart --restart, OnFailure=hydra-unit-failed@%n, logs, budget" {
  run bash "$TEST_TMPDIR/block.sh"
  [ "$status" -eq 0 ]
  svc="$TEST_TMPDIR/units/codex-edge-mirror.service"
  [ -f "$svc" ]
  grep -qx "ExecStart=$HYDRA_ROOT/scripts/lib/codex-edge-mirror.sh --restart" "$svc"
  grep -qx 'OnFailure=hydra-unit-failed@%n.service' "$svc"
  grep -qx 'Type=oneshot' "$svc"
  grep -qx 'TimeoutStartSec=900' "$svc"
  grep -qx 'StandardOutput=append:/var/log/codex-edge-mirror.log' "$svc"
}

@test "generates codex-edge-mirror.timer: daily 04:30 UTC, Persistent, bound to the service, enabled+started" {
  run bash "$TEST_TMPDIR/block.sh"
  [ "$status" -eq 0 ]
  tmr="$TEST_TMPDIR/units/codex-edge-mirror.timer"
  grep -qx 'OnCalendar=\*-\*-\* 04:30:00 UTC' "$tmr"
  grep -qx 'Persistent=true' "$tmr"
  grep -qx 'Unit=codex-edge-mirror.service' "$tmr"
  grep -qx 'WantedBy=timers.target' "$tmr"
  grep -q "daemon-reload" "$SYSTEMCTL_LOG"
  grep -q "enable codex-edge-mirror.timer" "$SYSTEMCTL_LOG"
  grep -q "start codex-edge-mirror.timer" "$SYSTEMCTL_LOG"
  [[ "$output" == *"codex-edge-mirror.timer: active"* ]]
}

@test "generates the hydra-unit-failed@ template: ExecStart notify-unit-failed.sh %i, oneshot" {
  run bash "$TEST_TMPDIR/block.sh"
  [ "$status" -eq 0 ]
  tpl="$TEST_TMPDIR/units/hydra-unit-failed@.service"
  grep -qx "ExecStart=$HYDRA_ROOT/scripts/notify-unit-failed.sh %i" "$tpl"
  grep -qx 'Type=oneshot' "$tpl"
}

@test "refuses (fail) when the mirror script or the notifier is missing from HYDRA_ROOT" {
  rm -f "$HYDRA_ROOT/scripts/lib/codex-edge-mirror.sh"
  run bash "$TEST_TMPDIR/block.sh"
  [ "$status" -ne 0 ]
  [[ "$output" == *"FATAL"*"codex-edge-mirror.sh missing"* ]]
  [ ! -f "$TEST_TMPDIR/units/codex-edge-mirror.service" ]
  printf '#!/bin/bash\nexit 0\n' > "$HYDRA_ROOT/scripts/lib/codex-edge-mirror.sh"; chmod +x "$HYDRA_ROOT/scripts/lib/codex-edge-mirror.sh"
  rm -f "$HYDRA_ROOT/scripts/notify-unit-failed.sh"
  run bash "$TEST_TMPDIR/block.sh"
  [ "$status" -ne 0 ]
  [[ "$output" == *"FATAL"*"notify-unit-failed.sh missing"* ]]
}
