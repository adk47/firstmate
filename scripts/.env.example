# Intercom webhook receiver — required environment variables
# Copy to .env and fill in real values (never commit .env)

# Required — server refuses to start without these
INTERCOM_WEBHOOK_SECRET=       # HMAC signing secret from Intercom Developer Hub
INTERCOM_TOKEN=                # Intercom API Bearer token
INTERCOM_BOT_ADMIN_ID=         # Intercom admin ID for bot-authored replies
OPENCLAW_TOKEN=                # OpenClaw Gateway auth token (from openclaw.json gateway.auth.token)

# Optional — have defaults
INTERCOM_WEBHOOK_PORT=18792    # Webhook listener port
INTERCOM_WORKSPACE_ID=         # Intercom workspace/app ID
OPENCLAW_URL=http://localhost:18789  # OpenClaw Gateway URL
DISPATCH_TIMEOUT_MS=15000      # Agent dispatch timeout in ms
